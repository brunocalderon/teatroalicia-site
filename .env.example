# Cloudflare Turnstile site key (public, Managed widget) — required for Formgong forms in production
# Register localhost + your production domain on the widget; add the secret key in Formgong form settings.
CLOUDFLARE_TURNSTILE_SITE_KEY=

# Formgong access_key (public) — set per form as `token` in content/forms/*.md
# See docs/astro-form-request-forms.md

# Meta (Facebook) Pixel — public ID from Events Manager
FACEBOOK_PIXEL_ID=

# Umami analytics — website ID from cloud.umami.is
UMAMI_PIXEL_ID=

# Meta custom parameter `city` on pixel events (default Santiago)
MARKETING_TRACKING_CITY=Santiago

# Marketing pixel timing (milliseconds)
# Invitation forms: idle timeout hint after load before Meta/Umami (see marketing bootstrap)
MARKETING_ENGAGE_MS=1000
# When marketingEngageAfterLoadMs is 0: requestIdleCallback timeout after first scroll or tap
MARKETING_INTERACTION_IDLE_TIMEOUT_MS=2000

# Canonical public site URL for build outputs (llms.txt, ard.json, absolute URLs).
# Set in Cloudflare Pages to your custom domain. Build also reads CF_PAGES_URL when unset.
SITE_URL=

# Instagram handle for thank-you page follow button (omit @; leave empty to hide the button)
THANK_YOU_INSTAGRAM_USERNAME=

# Airtable home cartelera and guest-list forms (required for / cartelera and /i/:slug in production).
# PAT scopes: data.records:read. Set the token as an encrypted variable in Cloudflare Pages.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Home cartelera table (tbl…). Snapshotted at build into /
AIRTABLE_TABLE_ID=
# Override cartelera table when different from AIRTABLE_TABLE_ID
# AIRTABLE_CARTELERA_TABLE_ID=
# Optional view (viw…) — adds view= to the home cartelera list API query when set
# AIRTABLE_CARTELERA_VIEW_ID=
# Guest-pass promoter roster (Promoters table in the same base)
AIRTABLE_PROMOTERS_TABLE_ID=
# AIRTABLE_PROMOTERS_VIEW_ID=
# Formgong access_key for all Airtable guest-list forms (`/i/:slug`)
AIRTABLE_INVITATION_FORM_TOKEN=