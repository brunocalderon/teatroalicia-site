---
import MetaPixel from '@/components/pixels/MetaPixel.astro';
import PageViewTracking from '@/components/pixels/PageViewTracking.astro';
import UmamiPixel from '@/components/pixels/UmamiPixel.astro';
import type { MarketingPageTracking } from '@/lib/marketing-page-tracking';

interface Props {
	title?: string;
	tracking?: MarketingPageTracking;
}

const { title = 'Coming soon', tracking } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#000000" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<MetaPixel />
		<UmamiPixel />
		{tracking ? <PageViewTracking {...tracking} /> : null}
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html {
		background-color: #000;
		color-scheme: dark;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}
</style>
