---
import MarketingHead from '@/components/pixels/MarketingHead.astro';
import ResourceHints from '@/components/resource-hints.astro';
import SchemaOrgJsonLd from '@/components/schema-org-json-ld.astro';
import { FORM_PAGE_BACKGROUND_HD_SOURCES } from '@/lib/form-page-background';
import type { MarketingPageTracking } from '@/lib/marketing-page-tracking';
import {
	formResourceHintOrigins,
	homeMarketingResourceHintOrigins,
} from '@/lib/third-party-resource-hints';
import { MARKETING_ENGAGE_MS } from 'astro:env/client';
import geistLatinWoff2 from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	tracking?: MarketingPageTracking;
	/** Preconnect hints for Turnstile / Formgong on invitation form routes. */
	formThirdPartyHints?: boolean;
	/** Post-load AVIF→WebP→JPEG backdrop swap (pairs with `sitePageBackdropCss`). */
	deferredSiteBackdrop?: boolean;
	/** Split invitation forms use the event poster as LCP — skip photographic backdrop swap. */
	skipFormPhotographicBackdrop?: boolean;
	lcpImage?: {
		src: string;
		srcSet: string;
		sizes: string;
	};
	/** Cartelera hero carousel: preload first slide WebP (not event poster LCP). */
	heroBackgroundPreload?: {
		src: string;
		srcSet?: string;
		sizes?: string;
	};
	/**
	 * Meta/Umami: ms after `load` to engage (0 = first user interaction).
	 * When omitted and `tracking` is set, uses `MARKETING_ENGAGE_MS`.
	 */
	marketingEngageAfterLoadMs?: number;
	/** Optional Schema.org graph or node for `<script type="application/ld+json">`. */
	jsonLd?: Record<string, unknown>;
	/** Inline layout CSS in `<head>` (invitation-form LCP). */
	headInlineCss?: string;
}

const {
	title = 'Coming soon',
	description,
	lang = 'en',
	tracking,
	formThirdPartyHints = false,
	deferredSiteBackdrop = false,
	skipFormPhotographicBackdrop = false,
	lcpImage,
	heroBackgroundPreload,
	marketingEngageAfterLoadMs: marketingEngageAfterLoadMsProp,
	jsonLd,
	headInlineCss,
} = Astro.props;

const marketingEngageAfterLoadMs =
	marketingEngageAfterLoadMsProp !== undefined
		? marketingEngageAfterLoadMsProp
		: tracking
			? MARKETING_ENGAGE_MS
			: 0;

const loadHdBackdropAfterPageLoad =
	(formThirdPartyHints && !skipFormPhotographicBackdrop) ||
	deferredSiteBackdrop;
---

<!doctype html>
<html lang={lang} class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{
			lcpImage ? (
				<link
					rel="preload"
					as="image"
					type="image/webp"
					href={lcpImage.src}
					fetchpriority="high"
				/>
			) : null
		}
		<meta name="theme-color" content="#000000" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href={geistLatinWoff2}
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link rel="describedby" href="/llms.txt" type="text/plain" />
		<link rel="ard" href="/.well-known/ard.json" type="application/ard+json" />
		<title>{title}</title>
		{description ? <meta name="description" content={description} /> : null}
		{headInlineCss ? <style is:inline set:html={headInlineCss} /> : null}
		<ResourceHints
			origins={
				formThirdPartyHints
					? formResourceHintOrigins
					: homeMarketingResourceHintOrigins
			}
		/>
		{
			heroBackgroundPreload ? (
				<link
					rel="preload"
					as="image"
					type="image/webp"
					href={heroBackgroundPreload.src}
					imagesrcset={heroBackgroundPreload.srcSet}
					imagesizes={heroBackgroundPreload.sizes}
					fetchpriority="high"
				/>
			) : null
		}
	</head>
	<body>
		<slot />
		{
			loadHdBackdropAfterPageLoad ? (
				<script
					is:inline
					set:html={`(function(){var s=${JSON.stringify(FORM_PAGE_BACKGROUND_HD_SOURCES)};function u(){var n=0;function t(){if(n>=s.length){return}var i=new Image();i.decoding="async";i.onload=function(){document.body.classList.add("form-page-bg-hd")};i.onerror=function(){n+=1;t()};i.src=s[n]}t()}function n(){if("requestIdleCallback"in window){requestIdleCallback(u,{timeout:2500})}else{setTimeout(u,0)}}if(document.readyState==="complete"){n()}else{window.addEventListener("load",n,{once:true})}})();`}
				/>
			) : null
		}
		<MarketingHead
			tracking={tracking}
			engageAfterLoadMs={marketingEngageAfterLoadMs}
		/>
		{jsonLd ? <SchemaOrgJsonLd data={jsonLd} /> : null}
	</body>
</html>

<style is:global>
	html {
		background-color: #000;
		color-scheme: dark;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		background-color: #000;
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}
</style>
