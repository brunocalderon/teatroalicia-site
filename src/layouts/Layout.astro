---
import MarketingHead from '@/components/pixels/MarketingHead.astro';
import type { MarketingPageTracking } from '@/lib/marketing-page-tracking';

interface Props {
	title?: string;
	lang?: string;
	tracking?: MarketingPageTracking;
	/** Preconnect hints for Turnstile / Formgong on invitation form routes. */
	formThirdPartyHints?: boolean;
	lcpImageSrc?: string;
}

const {
	title = 'Coming soon',
	lang = 'en',
	tracking,
	formThirdPartyHints = false,
	lcpImageSrc,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#000000" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{
			formThirdPartyHints ? (
				<>
					<link rel="preconnect" href="https://challenges.cloudflare.com" />
					<link rel="preconnect" href="https://formgong.com" />
					<link rel="dns-prefetch" href="https://challenges.cloudflare.com" />
					<link rel="dns-prefetch" href="https://formgong.com" />
				</>
			) : null
		}
		{
			lcpImageSrc ? (
				<link
					rel="preload"
					as="image"
					type="image/webp"
					href={lcpImageSrc}
					fetchpriority="high"
				/>
			) : null
		}
		<MarketingHead tracking={tracking} />
	</head>
	<body>
		{
			formThirdPartyHints ? (
				<script
					is:inline
					set:html={`(function(){function r(){document.body.classList.add("form-page-bg-ready")}var a=["pointerdown","keydown","touchstart","scroll"];function arm(){for(var i=0;i<a.length;i++){window.addEventListener(a[i],r,{once:true,passive:true})}}if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",arm)}else{arm()}})();`}
				/>
			) : null
		}
		<slot />
	</body>
</html>

<style is:global>
	html {
		background-color: #000;
		color-scheme: dark;
	}

	html,
	body {
		margin: 0;
		min-height: 100%;
	}

	body {
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		-webkit-font-smoothing: antialiased;
	}
</style>
