---
import {
  FACEBOOK_PIXEL_ID,
  MARKETING_INTERACTION_IDLE_TIMEOUT_MS,
  UMAMI_PIXEL_ID,
} from "astro:env/client"
import type { MarketingPageTracking } from "@/lib/marketing-page-tracking"
import {
  MARKETING_TRACKING_CITY,
  buildMetaTrackingPayload,
} from "@/lib/marketing-page-tracking"
import {
  isConfiguredFacebookPixelId,
  isConfiguredUmamiWebsiteId,
} from "@/lib/marketing-pixel-ids"

interface Props {
  tracking?: MarketingPageTracking
  /** After full page load, wait this many ms then load pixels (0 = first interaction). */
  engageAfterLoadMs?: number
}

const { tracking, engageAfterLoadMs = 0 } = Astro.props

const facebookPixelId = isConfiguredFacebookPixelId(FACEBOOK_PIXEL_ID)
  ? FACEBOOK_PIXEL_ID.trim()
  : ""
const umamiWebsiteId = isConfiguredUmamiWebsiteId(UMAMI_PIXEL_ID)
  ? UMAMI_PIXEL_ID.trim()
  : ""

const metaEvent = tracking?.metaEvent ?? "ViewContent"
const umamiEventName = tracking?.umamiEventName ?? tracking?.contentName ?? ""

const metaPayload = tracking
  ? JSON.stringify(
      buildMetaTrackingPayload({
        contentName: tracking.contentName,
        contentCategory: tracking.contentCategory,
        pageType: tracking.pageType,
        city: tracking.city ?? MARKETING_TRACKING_CITY,
      }),
    )
  : "null"

const marketingConfig = JSON.stringify({
  facebookPixelId,
  umamiWebsiteId,
  metaEvent,
  metaPayload,
  umamiEventName,
  trackContent: Boolean(tracking),
  engageAfterLoadMs,
  interactionIdleTimeoutMs: MARKETING_INTERACTION_IDLE_TIMEOUT_MS,
})
---

{
  facebookPixelId || umamiWebsiteId ? (
    <>
      {umamiWebsiteId ? (
        <script>
          import { bindUmamiPromoterEventDataResolver } from "@/lib/marketing-umami-track"
          bindUmamiPromoterEventDataResolver()
        </script>
      ) : null}
      <script
        is:inline
        type="application/json"
        id="marketing-head-config"
        set:html={marketingConfig}
      />
      <script
        is:inline
        set:html={`(function () {
  var CONFIG_EL = document.getElementById("marketing-head-config");
  if (!CONFIG_EL) return;
  var config;
  try {
    config = JSON.parse(CONFIG_EL.textContent || "{}");
  } catch (e) {
    return;
  }
  var engaged = false;

  function defineUmamiPageView(eventName) {
    if (!eventName) return;
    window.customPageViewTracking = function () {
      if (typeof window.umami !== "undefined" && window.umami.track) {
        var promoterData =
          typeof window.__umamiPromoterEventData === "function"
            ? window.__umamiPromoterEventData()
            : null;
        if (promoterData) {
          window.umami.track(eventName, promoterData);
        } else {
          window.umami.track(eventName);
        }
      }
    };
  }

  function ensureFacebookPixelBootstrap(pixelId) {
    if (!pixelId) return false;
    if (window.fbq) return true;
    !function (f, b, e, v, n, t, s) {
      if (f.fbq) return;
      n = f.fbq = function () {
        n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
      };
      if (!f._fbq) f._fbq = n;
      n.push = n;
      n.loaded = !0;
      n.version = "2.0";
      n.queue = [];
      t = b.createElement(e);
      t.async = !0;
      t.src = v;
      s = b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t, s);
    }(window, document, "script", "https://connect.facebook.net/en_US/fbevents.js");
    return true;
  }

  function loadFacebookPixel(pixelId, trackContent, metaEvent, metaPayloadJson) {
    if (!ensureFacebookPixelBootstrap(pixelId)) return;
    window.fbq("init", pixelId);
    window.fbq("track", "PageView");
    if (trackContent && metaPayloadJson) {
      try {
        var metaPayload = JSON.parse(metaPayloadJson);
        window.fbq("track", metaEvent, metaPayload);
      } catch (err) {
        window.fbq("track", metaEvent);
      }
    }
  }

  function loadUmami(websiteId) {
    if (!websiteId || document.querySelector('script[data-marketing-umami="true"]')) {
      return;
    }
    defineUmamiPageView(config.umamiEventName);
    var script = document.createElement("script");
    script.async = true;
    script.defer = true;
    script.dataset.websiteId = websiteId;
    script.dataset.marketingUmami = "true";
    script.src = "https://cloud.umami.is/script.js";
    script.onload = function () {
      if (typeof window.customPageViewTracking === "function") {
        window.customPageViewTracking();
      }
    };
    document.head.appendChild(script);
  }

  function runMarketingLoads() {
    if (config.facebookPixelId) {
      loadFacebookPixel(
        config.facebookPixelId,
        config.trackContent,
        config.metaEvent,
        config.metaPayload === "null" ? "" : config.metaPayload,
      );
    }
    if (config.umamiWebsiteId) {
      loadUmami(config.umamiWebsiteId);
    }
  }

  function engageMarketing() {
    if (engaged) return;
    engaged = true;
    if (config.engageAfterLoadMs > 0) {
      runMarketingLoads();
      return;
    }
    var idleTimeout =
      typeof config.interactionIdleTimeoutMs === "number"
        ? config.interactionIdleTimeoutMs
        : 2000;
    if ("requestIdleCallback" in window) {
      requestIdleCallback(runMarketingLoads, { timeout: idleTimeout });
    } else {
      setTimeout(runMarketingLoads, 0);
    }
  }

  var signals = ["pointerdown", "keydown", "touchstart", "scroll"];
  function armOnInteraction() {
    for (var i = 0; i < signals.length; i++) {
      window.addEventListener(signals[i], engageMarketing, {
        once: true,
        passive: true,
      });
    }
  }

  function armAfterFullLoad(delayMs) {
    function schedule() {
      setTimeout(engageMarketing, delayMs);
    }
    if (document.readyState === "complete") {
      schedule();
    } else {
      window.addEventListener("load", schedule, { once: true });
    }
  }

  window.engageMarketingPixels = engageMarketing;

  if (config.engageAfterLoadMs > 0) {
    armAfterFullLoad(config.engageAfterLoadMs);
  } else if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", armOnInteraction);
  } else {
    armOnInteraction();
  }
})();`}
      />
      {
        facebookPixelId ? (
          <noscript>
            <img
              height="1"
              width="1"
              style="display:none"
              alt=""
              src={`https://www.facebook.com/tr?id=${facebookPixelId}&ev=PageView&noscript=1`}
            />
          </noscript>
        ) : null
      }
    </>
  ) : null
}