---
import { FACEBOOK_PIXEL_ID, UMAMI_PIXEL_ID } from 'astro:env/client';
import type { MarketingPageTracking } from '@/lib/marketing-page-tracking';
import {
  MARKETING_TRACKING_CITY,
  buildMetaTrackingPayload,
} from '@/lib/marketing-page-tracking';

interface Props extends MarketingPageTracking {}

const {
  contentName,
  contentCategory,
  pageType,
  city = MARKETING_TRACKING_CITY,
  metaEvent = 'ViewContent',
  umamiEventName = contentName,
} = Astro.props;

const metaPayload = JSON.stringify(
  buildMetaTrackingPayload({
    contentName,
    contentCategory,
    pageType,
    city,
  })
);

const facebookPageViewTracking = `fbq('track', ${JSON.stringify(metaEvent)}, ${metaPayload});`;

const umamiPageViewTracking = `
  function customPageViewTracking() {
    umami.track(${JSON.stringify(umamiEventName)});
  }
`;
---

{
  FACEBOOK_PIXEL_ID ? (
    <script is:inline set:html={facebookPageViewTracking} />
  ) : null
}
{
  UMAMI_PIXEL_ID ? (
    <script is:inline defer set:html={umamiPageViewTracking} />
  ) : null
}