---
import { UMAMI_PIXEL_ID } from 'astro:env/client';

const umamiPixel = `
    (function() {
        let umamiReady = false;
        const script = document.createElement('script');
        script.async = true;
        script.defer = true;
        script.dataset.websiteId = '__UMAMI_PIXEL_ID__';
        script.src = 'https://cloud.umami.is/script.js';
        script.onload = function() {
            // Add your tracking stuff here like this:
            try {
                customPageViewTracking();
            } catch(e) {
                console.log('Error Tracking Custom PageView'); 
            }
        };
        script.onerror = function() {
            console.error('Failed to load Umami script.');
        };
        document.head.appendChild(script);
    })();
`.replace('__UMAMI_PIXEL_ID__', UMAMI_PIXEL_ID);
---

{UMAMI_PIXEL_ID ? <script is:inline set:html={umamiPixel} /> : null}