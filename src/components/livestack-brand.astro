---
import livestackLogoUrl from "@/assets/livestack-logo-white.png?url"

const livestackHref = "https://withlivestack.com?ref=teatroalicia"
---

<a
  href={livestackHref}
  class="livestack-brand"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Powered by Livestack"
>
  <img
    src={livestackLogoUrl}
    alt=""
    width="118"
    height="16"
    loading="lazy"
    fetchpriority="low"
    decoding="async"
  />
  <span class="livestack-brand__label" aria-hidden="true">Powered by Livestack</span>
</a>

<style>
  .livestack-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    justify-content: center;
    width: 100%;
    margin-top: auto;
    padding-top: 3.25rem;
    text-decoration: none;
  }

  .livestack-brand__label {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, #f5f5f5 75%, #0a0a0a);
    transition: color 0.15s ease;
  }

  .livestack-brand:hover .livestack-brand__label,
  .livestack-brand:focus-visible .livestack-brand__label {
    color: color-mix(in srgb, #f5f5f5 88%, #0a0a0a);
  }

  .livestack-brand img {
    display: block;
    height: 1rem;
    width: auto;
    opacity: 0.88;
    transition: opacity 0.15s ease;
  }

  @media (max-width: 55.99rem) {
    .livestack-brand {
      padding-top: 5.25rem;
    }

    .livestack-brand img {
      height: 0.75rem;
    }

    .livestack-brand__label {
      font-size: 0.625rem;
    }
  }

  .livestack-brand:hover img,
  .livestack-brand:focus-visible img {
    opacity: 1;
  }

  .livestack-brand:focus-visible {
    outline: 2px solid color-mix(in srgb, #f5f5f5 45%, transparent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
</style>

<script
  is:inline
  set:html={`(function(){function t(e){var n=e.target&&e.target.closest&&e.target.closest("a.livestack-brand");if(!n)return;var u=window.umami;u&&u.track&&u.track("Powered By Badge Click",{page_path:location.pathname})}function a(){document.addEventListener("click",t)}if("requestIdleCallback"in window)requestIdleCallback(a,{timeout:8e3});else setTimeout(a,1)})();`}
/>