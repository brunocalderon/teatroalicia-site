---
import livestackLogoUrl from "@/assets/livestack-logo-white.png?url"

const livestackHref = "https://withlivestack.com?ref=teatroalicia"
const livestackBrandLabel = "Livestack · Technology Partner"
---

<a
  href={livestackHref}
  class="livestack-brand"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={livestackBrandLabel}
>
  <img
    src={livestackLogoUrl}
    alt=""
    width="118"
    height="16"
    loading="lazy"
    fetchpriority="low"
    decoding="async"
  />
  <span class="livestack-brand__label" aria-hidden="true">{livestackBrandLabel}</span>
</a>

<style>
  .livestack-brand {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    width: fit-content;
    max-width: 100%;
    margin-top: auto;
    margin-inline: auto;
    padding-top: 3.25rem;
    text-decoration: none;
  }

  .livestack-brand__label {
    margin-top: 0;
    max-width: 16.5rem;
    text-align: center;
    text-wrap: balance;
    font-size: 0.625rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.045em;
    color: color-mix(in srgb, #f5f5f5 75%, #0a0a0a);
    transition: color 0.15s ease;
  }

  .livestack-brand:hover .livestack-brand__label,
  .livestack-brand:focus-visible .livestack-brand__label {
    color: color-mix(in srgb, #f5f5f5 88%, #0a0a0a);
  }

  .livestack-brand img {
    display: block;
    height: 0.75rem;
    width: auto;
    opacity: 0.88;
    transition: opacity 0.15s ease;
  }

  @media (max-width: 55.99rem) {
    .livestack-brand {
      padding-top: 5.25rem;
    }

  }

  .livestack-brand:hover img,
  .livestack-brand:focus-visible img {
    opacity: 1;
  }

  .livestack-brand:focus-visible {
    outline: 2px solid color-mix(in srgb, #f5f5f5 45%, transparent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
</style>

<script>
  import { trackUmamiLivestackBadgeClick } from "@/lib/track-umami-livestack-badge"

  document.addEventListener("click", (event) => {
    const target = (event.target as Element).closest<HTMLAnchorElement>(
      "a.livestack-brand",
    )
    if (!target) {
      return
    }
    trackUmamiLivestackBadgeClick()
  })
</script>