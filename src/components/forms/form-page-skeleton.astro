---
import type { FormField, FormFieldType } from "@/lib/form-schema"

import "@/styles/form.css"

interface Props {
  fields: FormField[]
  lang?: string
}

const { fields, lang = "es" } = Astro.props

const loadingMessage =
  lang === "es" ? "Cargando formulario…" : "Loading form…"

const hasReferralField = fields.some((field) => field.type === "referral")
const skeletonFields = fields.filter((field) => field.type !== "referral")

function fieldSpansFullWidth(type: FormFieldType): boolean {
  switch (type) {
    case "checkbox":
    case "textarea":
    case "file":
      return true
    default:
      return false
  }
}

function skeletonFieldClassName(type: FormFieldType): string {
  return fieldSpansFullWidth(type)
    ? "form-field form-field--full"
    : "form-field"
}
---

<div class="form-form form-form--skeleton" aria-busy="true">
  <span class="sr-only">{loadingMessage}</span>
  <fieldset class="form-fieldset" disabled aria-hidden="true">
    {
      hasReferralField ? (
        <div
          class="form-field form-field--referral form-field--full"
          data-referral-skeleton
        >
          <div class="form-referral-display" aria-hidden="true">
            <div class="form-skeleton form-skeleton--referral-item form-referral-item">
              <span class="form-skeleton form-skeleton--referral-icon" />
              <span class="form-skeleton form-skeleton--referral-line" />
            </div>
          </div>
        </div>
      ) : null
    }
    {
      skeletonFields.map((field) => (
        <div class={skeletonFieldClassName(field.type)}>
          <span class="form-skeleton form-skeleton--label" />
          {field.type === "tel" ? (
            <div class="form-skeleton form-skeleton--phone">
              <span class="form-skeleton form-skeleton--phone-country" />
              <span class="form-skeleton form-skeleton--phone-number" />
            </div>
          ) : field.type === "date" ? (
            <div class="form-skeleton form-skeleton--birthday">
              <span class="form-skeleton form-skeleton--birthday-segment" />
              <span class="form-skeleton form-skeleton--birthday-sep" />
              <span class="form-skeleton form-skeleton--birthday-segment" />
              <span class="form-skeleton form-skeleton--birthday-sep" />
              <span class="form-skeleton form-skeleton--birthday-segment form-skeleton--birthday-year" />
            </div>
          ) : (
            <span
              class:list={[
                "form-skeleton form-skeleton--control",
                field.type === "textarea" && "form-skeleton--textarea",
              ]}
            />
          )}
        </div>
      ))
    }

    <div class="form-field form-field--full">
      <span class="form-skeleton form-skeleton--label form-skeleton--turnstile-label" />
      <div class="form-skeleton form-skeleton--control form-skeleton--turnstile" />
    </div>

    <button
      type="button"
      class="form-submit form-skeleton form-skeleton--submit"
      disabled
      tabindex="-1"
    />
  </fieldset>
</div>

<script is:inline>
  (function () {
    var params = new URLSearchParams(location.search)
    if (!(params.get("e") || "").trim()) {
      document.querySelectorAll("[data-referral-skeleton]").forEach(function (el) {
        el.remove()
      })
    }
  })()
</script>

<style is:global>
  .form-form--skeleton .form-fieldset[disabled] {
    opacity: 1;
  }

  .form-skeleton {
    display: block;
    border-radius: 0.5rem;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, #f5f5f5 8%, #000) 0%,
      color-mix(in srgb, #f5f5f5 16%, #000) 45%,
      color-mix(in srgb, #f5f5f5 8%, #000) 100%
    );
    background-size: 200% 100%;
    animation: form-skeleton-shimmer 1.35s ease-in-out infinite;
  }

  @keyframes form-skeleton-shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .form-skeleton {
      animation: none;
      background: color-mix(in srgb, #f5f5f5 10%, #000);
    }
  }

  .form-skeleton--label {
    width: 42%;
    max-width: 9rem;
    height: 0.75rem;
    margin-bottom: 0.375rem;
  }

  .form-skeleton--turnstile-label {
    width: 7rem;
    max-width: 55%;
  }

  .form-skeleton--control {
    width: 100%;
    height: calc(0.625rem * 2 + 1.25 * var(--form-control-font-size, 1rem));
  }

  .form-skeleton--textarea {
    height: 6rem;
  }

  .form-skeleton--phone {
    display: flex;
    gap: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, #f5f5f5 14%, transparent);
    background: color-mix(in srgb, #f5f5f5 4%, #000);
    animation: none;
  }

  .form-skeleton--phone-country,
  .form-skeleton--phone-number {
    height: calc(0.625rem * 2 + 1.25 * var(--form-control-font-size, 1rem));
    border-radius: 0;
    animation: form-skeleton-shimmer 1.35s ease-in-out infinite;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, #f5f5f5 8%, #000) 0%,
      color-mix(in srgb, #f5f5f5 16%, #000) 45%,
      color-mix(in srgb, #f5f5f5 8%, #000) 100%
    );
    background-size: 200% 100%;
  }

  .form-skeleton--phone-country {
    flex: 0 0 5.5rem;
    border-right: 1px solid color-mix(in srgb, #f5f5f5 14%, transparent);
  }

  .form-skeleton--phone-number {
    flex: 1 1 auto;
    min-width: 0;
  }

  .form-skeleton--birthday {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    animation: none;
    background: transparent;
  }

  .form-skeleton--birthday-segment {
    flex: 0 0 3.25rem;
    height: calc(0.625rem * 2 + 1.25 * var(--form-control-font-size, 1rem));
  }

  .form-skeleton--birthday-year {
    flex: 1 1 4.75rem;
    min-width: 4.75rem;
  }

  .form-skeleton--birthday-sep {
    width: 0.35rem;
    height: 0.75rem;
    border-radius: 0.15rem;
    background: color-mix(in srgb, #f5f5f5 20%, transparent);
    animation: none;
  }

  .form-skeleton--turnstile {
    min-height: 4rem;
    height: 4rem;
  }

  .form-skeleton--submit {
    width: 100%;
    height: calc(0.65rem * 2 + 1.25rem * 1.25);
    border: 0;
    margin-top: 0.5rem;
    opacity: 0.65;
    cursor: default;
  }

  /* Match shadcn Item outline sm (~41px) for guest-pass referral row */
  .form-skeleton--referral-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    box-sizing: border-box;
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 1px solid color-mix(in srgb, #f5f5f5 14%, transparent);
    border-radius: 0.5rem;
    animation: none;
    background: transparent;
  }

  .form-skeleton--referral-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
  }

  .form-skeleton--referral-line {
    flex: 0 1 auto;
    width: 12rem;
    max-width: 55%;
    height: 1rem;
  }
</style>