---
import livestackLogoUrl from "@/assets/livestack-logo-white.png?url"

const livestackHref = "https://withlivestack.com?ref=teatroalicia"
---

<a
  href={livestackHref}
  class="form-page__livestack"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Powered by Livestack"
>
  <img
    src={livestackLogoUrl}
    alt=""
    width="118"
    height="16"
    loading="lazy"
    fetchpriority="low"
    decoding="async"
  />
  <span class="form-page__livestack-label" aria-hidden="true">Powered by Livestack</span>
</a>

<style>
  .form-page__livestack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    justify-content: center;
    width: 100%;
    margin-top: auto;
    padding-top: 3.25rem;
    text-decoration: none;
  }

  .form-page__livestack-label {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, #f5f5f5 75%, #0a0a0a);
    transition: color 0.15s ease;
  }

  .form-page__livestack:hover .form-page__livestack-label,
  .form-page__livestack:focus-visible .form-page__livestack-label {
    color: color-mix(in srgb, #f5f5f5 88%, #0a0a0a);
  }

  .form-page__livestack img {
    display: block;
    height: 1rem;
    width: auto;
    opacity: 0.88;
    transition: opacity 0.15s ease;
  }

  @media (max-width: 55.99rem) {
    .form-page__livestack {
      padding-top: 5.25rem;
    }

    .form-page__livestack img {
      height: 0.75rem;
    }

    .form-page__livestack-label {
      font-size: 0.625rem;
    }
  }

  .form-page__livestack:hover img,
  .form-page__livestack:focus-visible img {
    opacity: 1;
  }

  .form-page__livestack:focus-visible {
    outline: 2px solid color-mix(in srgb, #f5f5f5 45%, transparent);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
</style>