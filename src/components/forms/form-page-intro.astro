---
import { Separator } from "@/components/ui/separator"
import type { AstroComponentFactory } from "astro/runtime/server/index.js"

export interface Props {
  formBodyHtml?: string
  renderedBody?: AstroComponentFactory | null
  split?: boolean
}

const { formBodyHtml, renderedBody, split = false } = Astro.props
const BodyContent = renderedBody
---

<div
  class:list={["form-page__intro", split && "form-page__split-intro"]}
>
  {
    formBodyHtml ? (
      <div class="form-page__intro-markdown" set:html={formBodyHtml} />
    ) : (
      BodyContent ? <BodyContent /> : null
    )
  }
  <Separator className="form-page__intro-separator" />
</div>

<style>
  .form-page__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.55;
    color: color-mix(in srgb, #f5f5f5 85%, transparent);
  }

  .form-page__split-intro {
    margin-bottom: 0;
  }

  .form-page__intro :global(.form-page__intro-separator) {
    margin: 0;
    width: 100%;
  }

  @media (min-width: 56rem) {
    .form-page__intro :global(.form-page__intro-separator) {
      display: none;
    }
  }

  .form-page__intro:not(.form-page__split-intro) .form-page__intro-markdown {
    margin-top: 1rem;
  }

  .form-page__intro :global(p),
  .form-page__intro-markdown :global(p) {
    margin: 0;
  }

  .form-page__intro :global(p + p),
  .form-page__intro-markdown :global(p + p) {
    margin-top: 0.625rem;
  }

  .form-page__intro-markdown :global(h1),
  .form-page__intro-markdown :global(h2),
  .form-page__intro-markdown :global(h3),
  .form-page__intro-markdown :global(h4) {
    margin: 0;
    font-weight: 600;
    line-height: 1.25;
    color: #f2f0ef;
    letter-spacing: 0.02em;
  }

  .form-page__intro-markdown :global(h3) {
    font-size: 1.25rem;
  }

  .form-page__intro-markdown :global(h2) {
    font-size: 1.375rem;
  }

  .form-page__intro-markdown :global(h1) {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .form-page__intro-markdown :global(h4) {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .form-page__intro-markdown :global(:is(h1, h2, h3, h4) + p) {
    margin-top: 0.625rem;
  }

  .form-page__intro-markdown :global(:is(h1, h2, h3, h4) + :is(h1, h2, h3, h4)) {
    margin-top: 0.75rem;
  }

  .form-page__intro-markdown :global(p + :is(h1, h2, h3, h4)) {
    margin-top: 1rem;
  }

  .form-page__intro-markdown :global(ul),
  .form-page__intro-markdown :global(ol) {
    margin: 0.625rem 0 0;
    padding-left: 1.5rem;
    list-style-position: outside;
    line-height: 1.55;
  }

  .form-page__intro-markdown :global(ul) {
    list-style-type: disc;
  }

  .form-page__intro-markdown :global(ol) {
    list-style-type: decimal;
  }

  .form-page__intro-markdown :global(li) {
    display: list-item;
    line-height: inherit;
    margin-block: 0;
    padding-block: 0;
    padding-inline-start: 0.2rem;
  }

  .form-page__intro-markdown :global(ul li::marker) {
    color: color-mix(in srgb, #f2f0ef 82%, transparent);
  }

  .form-page__intro-markdown :global(ol li::marker) {
    color: color-mix(in srgb, #f2f0ef 72%, transparent);
    font-variant-numeric: tabular-nums;
  }

  .form-page__intro-markdown :global(:is(h1, h2, h3, h4) + ul),
  .form-page__intro-markdown :global(:is(h1, h2, h3, h4) + ol) {
    margin-top: 0.5rem;
  }

  .form-page__intro-markdown :global(strong) {
    font-weight: 600;
    color: #f2f0ef;
  }
</style>