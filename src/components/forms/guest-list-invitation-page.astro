---
import FormSplitPage from "@/components/forms/form-split-page.astro"
import type { GuestListInvitationPageContext } from "@/lib/guest-list/prepare-guest-list-invitation-page"
import { MARKETING_ENGAGE_MS } from "astro:env/client"

type Props = GuestListInvitationPageContext & {
  loadTurnstileAfterLoad?: boolean
}

const {
  data,
  hasReferralField,
  formBodyHtml,
  showFormIntro,
  formLcpImage,
  showSplitLayout,
  tracking,
  formDescription,
  formJsonLd,
  formPageBackdropCss,
  pageLcpImage,
  loadTurnstileAfterLoad = false,
} = Astro.props
---

<FormSplitPage
  title={data.title}
  description={formDescription}
  lang={data.lang}
  tracking={tracking}
  jsonLd={formJsonLd}
  pageLcpImage={pageLcpImage}
  pageBackdropCss={formPageBackdropCss}
  showSplitLayout={showSplitLayout}
  splitVisualImage={formLcpImage}
  showIntro={showFormIntro}
  introHtml={formBodyHtml}
  imageAlt={data.imageAlt ?? data.title}
  livestackFooter={data.livestackFooter ?? false}
  formThirdPartyHints
  marketingEngageAfterLoadMs={MARKETING_ENGAGE_MS}
>
  {
    hasReferralField ? (
      <Fragment slot="head">
        <style
          is:inline
          set:html={`.form-fieldset > .form-field.form-field--referral{display:none}html.has-guest-pass-ref .form-fieldset > .form-field.form-field--referral{display:flex;height:2.625rem;min-height:2.625rem;max-height:2.625rem}html.has-guest-pass-ref .form-referral-item{box-sizing:border-box;height:2.625rem;max-height:2.625rem;overflow:hidden;flex-wrap:nowrap}`}
        />
        <script
          is:inline
          set:html={`(function(){var e=(new URLSearchParams(location.search).get("e")||"").trim();if(e)document.documentElement.classList.add("has-guest-pass-ref");})();`}
        />
      </Fragment>
    ) : null
  }
  <slot />
  {
    loadTurnstileAfterLoad ? (
      <script
        slot="foot"
        is:inline
        set:html={`(function(){function l(){var t=document.createElement("script");t.src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";t.async=true;t.defer=true;document.body.appendChild(t);}function s(){if("requestIdleCallback"in window)requestIdleCallback(l,{timeout:4e3});else setTimeout(l,0);}if(document.readyState==="complete")s();else window.addEventListener("load",s,{once:true});})();`}
      />
    ) : null
  }
</FormSplitPage>