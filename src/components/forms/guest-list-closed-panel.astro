---
import { guestListFormEs } from "../../../content/i18n/guest-list-form.es"

import "@/styles/form.css"

type Props = {
  purchaseUrl?: string
}

const { purchaseUrl } = Astro.props
const purchaseHref = purchaseUrl?.trim()
---

<div
  class="form-guest-list-closed"
  role="status"
  aria-live="polite"
>
  <p class="form-guest-list-closed__message">{guestListFormEs.closed.message}</p>
  {
    purchaseHref ? (
      <a
        class="form-submit"
        href={purchaseHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="form-submit__inner">
          <span class="form-submit__label">{guestListFormEs.closed.purchaseCta}</span>
          <svg
            class="form-submit__icon"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    ) : null
  }
</div>