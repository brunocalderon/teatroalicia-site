---
import { guestListFormEs } from "../../../content/i18n/guest-list-form.es"
import { resolveGuestListPurchaseHref } from "@/lib/guest-list/guest-list-purchase-href"
import type { FormEntryData } from "@/lib/form-schema"

import "@/styles/form.css"

type Props = {
  data: Pick<FormEntryData, "ticketUrl" | "ticketLink" | "eventId" | "path">
}

const { data } = Astro.props
const purchaseHref = resolveGuestListPurchaseHref(data)
const { closed } = guestListFormEs
---

<div
  class="form-guest-list-closed"
  role="status"
  aria-live="polite"
>
  <h2 class="form-guest-list-closed__heading">{closed.heading}</h2>
  <p class="form-guest-list-closed__message">
    {closed.bodyLead}<em class="form-guest-list-closed__brand">{closed.bodyBrand}</em
    >{closed.bodyTail}
  </p>
  <p class="form-guest-list-closed__signoff">{closed.signoff}</p>
  {
    purchaseHref ? (
      <a
        class="form-submit"
        href={purchaseHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="form-submit__inner">
          <span class="form-submit__label">{closed.purchaseCta}</span>
          <svg
            class="form-submit__icon"
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    ) : null
  }
</div>