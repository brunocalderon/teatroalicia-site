---
import { ThankYouBody } from "@/components/forms/thank-you-body"
import SiteBrand from "@/components/site-brand.astro"
import Layout from "@/layouts/Layout.astro"
import type { MarketingPageTracking } from "@/lib/marketing-page-tracking"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"

export interface Props {
  title: string
  lang: string
  paragraphsHtml: string[]
  marketingTracking: MarketingPageTracking
}

const { title, lang, paragraphsHtml, marketingTracking } = Astro.props

const formPageBackdropCss = sitePageBackdropCss("form-page")
---

<Layout
  title={title}
  lang={lang}
  tracking={marketingTracking}
  formThirdPartyHints
>
  <main class="form-page form-page--thank-you">
    <div class="form-page__split">
      <div class="form-page__masthead form-page__split-masthead">
        <SiteBrand align="start" />
        <header class="form-page__header">
          <h1>{title}</h1>
        </header>
      </div>
      <div class="form-page__split-lead form-page__thank-you-lead">
        <div class="form-page__thank-you-content">
          <ThankYouBody
            client:only="react"
            paragraphsHtml={paragraphsHtml}
            locale={lang}
            marketingTracking={marketingTracking}
          />
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global set:html={formPageBackdropCss}></style>

<style>
  .form-page {
    width: min(75rem, calc(100% - 4rem));
    max-width: 100%;
    margin-block: 2rem;
    margin-inline: auto;
    min-height: calc(100dvh - 4rem);
    padding: 2rem 1.5rem 3rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    background-color: color-mix(in srgb, #0a0a0a 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, #f5f5f5 10%, transparent);
    border-radius: 1rem;
  }

  .form-page.form-page--thank-you {
    min-height: 0;
  }

  .form-page--thank-you .form-page__split {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 0 0 auto;
    width: 100%;
    min-width: 0;
  }

  .form-page__thank-you-lead {
    min-width: 0;
  }

  .form-page__masthead {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem 1.5rem;
    min-width: 0;
    margin-bottom: 0;
  }

  .form-page__masthead .form-page__header {
    flex: 1;
    min-width: 0;
  }

  .form-page__masthead h1,
  .form-page__masthead .form-page__header h1 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.25;
  }

  @media (min-width: 56rem) {
    .form-page.form-page--thank-you {
      max-width: min(100%, 36rem);
    }

    .form-page--thank-you .form-page__split {
      gap: 2rem;
    }
  }

  @media (max-width: 55.99rem) {
    .form-page {
      width: calc(100% - 1.5rem);
      margin-block: 0.75rem;
      margin-inline: auto;
      min-height: calc(100dvh - 1.5rem);
      padding: 1.25rem 1rem 2rem;
    }

    .form-page.form-page--thank-you {
      padding: 1rem 1rem 2rem;
    }

    .form-page--thank-you .form-page__split-masthead {
      flex-direction: row;
      align-items: center;
      gap: 0.875rem 1rem;
      margin-top: 0;
      margin-bottom: 1rem;
    }

    .form-page--thank-you .form-page__split-masthead h1 {
      font-size: clamp(1.125rem, 5vw, 1.5rem);
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
  }

  .form-page--thank-you .form-page__thank-you-content :global(.form-page__thank-you-body) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-page--thank-you .form-page__thank-you-content :global(.form-page__thank-you-body p) {
    margin: 0;
    line-height: 1.55;
    color: color-mix(in srgb, #f5f5f5 85%, transparent);
  }

  .form-page--thank-you
    .form-page__thank-you-content
    :global(.form-page__thank-you-body p + p) {
    margin-top: 0.625rem;
  }

  .form-page--thank-you
    .form-page__thank-you-content
    :global(.form-page__thank-you-body p em) {
    font-style: italic;
  }

  .form-page--thank-you
    .form-page__thank-you-content
    :global(.form-page__thank-you-body p strong) {
    font-weight: 600;
  }
</style>