---
import { THANK_YOU_INSTAGRAM_USERNAME } from "astro:env/server"

import { ThankYouBody } from "@/components/forms/thank-you-body"
import SiteBrand from "@/components/site-brand.astro"
import Layout from "@/layouts/Layout.astro"
import type { MarketingPageTracking } from "@/lib/marketing-page-tracking"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"
import {
  instagramProfileUrl,
  normalizeInstagramUsername,
} from "@/lib/thank-you-instagram"

export interface Props {
  title: string
  lang: string
  paragraphsHtml: string[]
  marketingTracking: MarketingPageTracking
  thankYouInstagram?: boolean
}

const {
  title,
  lang,
  paragraphsHtml,
  marketingTracking,
  thankYouInstagram,
} = Astro.props

const showThankYouInstagram = thankYouInstagram === true

const formPageBackdropCss = sitePageBackdropCss("form-page")
const thankYouInstagramUsername = showThankYouInstagram
  ? normalizeInstagramUsername(THANK_YOU_INSTAGRAM_USERNAME)
  : ""
const thankYouInstagramHref = thankYouInstagramUsername
  ? instagramProfileUrl(thankYouInstagramUsername)
  : undefined
const thankYouInstagramHandleLabel = thankYouInstagramUsername
  ? `@${thankYouInstagramUsername}`
  : ""
---

<Layout
  title={title}
  lang={lang}
  tracking={marketingTracking}
  formThirdPartyHints
>
  <main class="form-page form-page--thank-you">
    <div class="form-page__split">
      <div class="form-page__masthead form-page__split-masthead">
        <SiteBrand align="start" />
        <header class="form-page__header">
          <h1>{title}</h1>
        </header>
      </div>
      <div class="form-page__split-lead form-page__thank-you-lead">
        <div class="form-page__thank-you-content">
          <ThankYouBody
            client:only="react"
            paragraphsHtml={paragraphsHtml}
            locale={lang}
            marketingTracking={marketingTracking}
          />
          {
            thankYouInstagramHref ? (
              <a
                class="form-thank-you-instagram"
                href={thankYouInstagramHref}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={
                  lang === "es"
                    ? `Sigue a Alicia Prime en Instagram (@${thankYouInstagramUsername})`
                    : `Follow Alicia Prime on Instagram (@${thankYouInstagramUsername})`
                }
              >
                <span class="form-thank-you-instagram__inner">
                  <svg
                    class="form-thank-you-instagram__icon"
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069ZM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0Zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881Z" />
                  </svg>
                  <span>{thankYouInstagramHandleLabel}</span>
                </span>
              </a>
            ) : null
          }
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global set:html={formPageBackdropCss}></style>

<style>
  .form-page {
    width: min(75rem, calc(100% - 4rem));
    max-width: 100%;
    margin-block: 2rem;
    margin-inline: auto;
    min-height: calc(100dvh - 4rem);
    padding: 2rem 1.5rem 3rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    background-color: color-mix(in srgb, #0a0a0a 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, #f5f5f5 10%, transparent);
    border-radius: 1rem;
  }

  .form-page.form-page--thank-you {
    min-height: 0;
  }

  .form-page--thank-you .form-page__split {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 0 0 auto;
    width: 100%;
    min-width: 0;
  }

  .form-page__thank-you-lead {
    min-width: 0;
  }

  .form-page__masthead {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem 1.5rem;
    min-width: 0;
    margin-bottom: 0;
  }

  .form-page__masthead .form-page__header {
    flex: 1;
    min-width: 0;
  }

  .form-page__masthead h1,
  .form-page__masthead .form-page__header h1 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.25;
  }

  @media (min-width: 56rem) {
    .form-page.form-page--thank-you {
      max-width: min(100%, 36rem);
    }

    .form-page--thank-you .form-page__split {
      gap: 2rem;
    }
  }

  @media (max-width: 55.99rem) {
    .form-page {
      width: calc(100% - 1.5rem);
      margin-block: 0.75rem;
      margin-inline: auto;
      min-height: calc(100dvh - 1.5rem);
      padding: 1.25rem 1rem 2rem;
    }

    .form-page.form-page--thank-you {
      padding: 1rem 1rem 2rem;
    }

    .form-page--thank-you .form-page__split-masthead {
      flex-direction: row;
      align-items: center;
      gap: 0.875rem 1rem;
      margin-top: 0;
      margin-bottom: 1rem;
    }

    .form-page--thank-you .form-page__split-masthead h1 {
      font-size: clamp(1.125rem, 5vw, 1.5rem);
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
  }

  .form-page--thank-you .form-page__thank-you-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-page--thank-you .form-page__thank-you-content :global(.form-page__thank-you-body) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-page--thank-you .form-thank-you-instagram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    margin: 0;
    padding: 0.65rem 1.25rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, #f6f4f0 72%, #f5f5f5);
    background-color: #f6f4f0;
    color: #1a1a1a;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .form-page--thank-you .form-thank-you-instagram__inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
  }

  .form-page--thank-you .form-thank-you-instagram__icon {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  .form-page--thank-you .form-thank-you-instagram:hover {
    background-color: color-mix(in srgb, #f6f4f0 90%, #000);
  }

  .form-page--thank-you .form-page__thank-you-content :global(.form-page__thank-you-body p) {
    margin: 0;
    line-height: 1.55;
    color: color-mix(in srgb, #f5f5f5 85%, transparent);
  }

  .form-page--thank-you
    .form-page__thank-you-content
    :global(.form-page__thank-you-body p + p) {
    margin-top: 0.625rem;
  }

  .form-page--thank-you
    .form-page__thank-you-content
    :global(.form-page__thank-you-body p em) {
    font-style: italic;
  }

  .form-page--thank-you
    .form-page__thank-you-content
    :global(.form-page__thank-you-body p strong) {
    font-weight: 600;
  }
</style>