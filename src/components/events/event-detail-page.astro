---
import HomeContactFooter from "@/components/home/home-contact-footer.astro"
import HomeHeader from "@/components/home/home-header.astro"
import EventDetailDescription from "@/components/events/event-detail-description.astro"
import Layout from "@/layouts/Layout.astro"
import type { EventDetailPageContext } from "@/lib/events/prepare-event-detail-page"
import { eventDetailPosterZoomSrc } from "@/lib/events/event-detail-poster-zoom-src"
import { MARKETING_ENGAGE_MS } from "astro:env/client"
import { venueConfig } from "../../../content/venue"

import "@/styles/home-footer.css"
import "@/styles/home-header.css"
import "@/styles/event-detail-poster-lightbox.css"

type Props = EventDetailPageContext

const {
  title,
  lang,
  pageDescription,
  descriptionHtml,
  posterImage,
  imageAlt,
  tracking,
  jsonLd,
  backdropCss,
  lcpImage,
} = Astro.props

const hasPoster = Boolean(posterImage)
const posterZoomSrc = posterImage
  ? eventDetailPosterZoomSrc(posterImage)
  : undefined
---

<Layout
  title={title}
  description={pageDescription}
  lang={lang}
  tracking={tracking}
  lcpImage={lcpImage}
  deferredSiteBackdrop
  marketingEngageAfterLoadMs={MARKETING_ENGAGE_MS}
  jsonLd={jsonLd}
>
  <div class="event-detail-page">
    <HomeHeader carteleraHref="/#cartelera" />
    <main class="event-detail__card event-detail__card--with-header">
      <div class="event-detail__masthead">
        <header class="event-detail__header">
          <h1>{title}</h1>
        </header>
      </div>

      <div
        class:list={[
          "event-detail__grid",
          !hasPoster && "event-detail__grid--no-poster",
        ]}
      >
        {
          hasPoster && posterImage && posterZoomSrc ? (
            <figure class="event-detail__visual">
              <button
                type="button"
                class="event-detail__visual-zoom"
                data-cartelera-poster-zoom
                data-zoom-src={posterZoomSrc}
                data-event-title={title}
                aria-label={`Ampliar afiche de ${title}`}
              >
                <img
                  src={posterImage.src}
                  srcset={posterImage.srcSet}
                  sizes={posterImage.sizes}
                  alt={imageAlt}
                  width={posterImage.width}
                  height={posterImage.height}
                  loading="eager"
                  fetchpriority="high"
                  decoding="sync"
                />
              </button>
            </figure>
          ) : null
        }

        <div class="event-detail__description">
          {descriptionHtml ? (
            <EventDetailDescription html={descriptionHtml} />
          ) : null}
        </div>

        <aside class="event-detail__meta">
          <slot />
        </aside>
      </div>
    </main>
    <HomeContactFooter venue={venueConfig} />
    {
      hasPoster ? (
        <div
          class="event-detail-poster-lightbox"
          data-cartelera-poster-lightbox
          hidden
          role="dialog"
          aria-modal="true"
          aria-labelledby="event-detail-poster-lightbox-label"
        >
          <p id="event-detail-poster-lightbox-label" class="sr-only">
            Afiche del evento
          </p>
          <p class="sr-only" data-cartelera-poster-lightbox-title />
          <button
            type="button"
            class="event-detail-poster-lightbox__backdrop"
            data-cartelera-poster-lightbox-close
            aria-label="Cerrar afiche ampliado"
          />
          <div class="event-detail-poster-lightbox__panel">
            <button
              type="button"
              class="event-detail-poster-lightbox__close"
              data-cartelera-poster-lightbox-close
              aria-label="Cerrar"
            >
              Cerrar
            </button>
            <img
              class="event-detail-poster-lightbox__image"
              data-cartelera-poster-lightbox-image
              alt=""
              decoding="async"
            />
          </div>
        </div>
      ) : null
    }
  </div>
  {
    hasPoster ? (
      <script>
        import { initCarteleraPosterLightbox } from "@/lib/cartelera-poster-lightbox"

        const root = document.querySelector(".event-detail-page")
        if (root) {
          initCarteleraPosterLightbox(root, { mobileOnly: false })
        }
      </script>
    ) : null
  }
</Layout>

<style is:global set:html={backdropCss}></style>

<style>
  .event-detail-page {
    --home-max: 75rem;
    --home-gutter: clamp(1.25rem, 4vw, 2.5rem);
    --home-fg: #f2f0ef;
    --home-muted: color-mix(in srgb, var(--home-fg) 72%, transparent);
    --home-line: color-mix(in srgb, var(--home-fg) 18%, transparent);
  }

  .event-detail__card {
    width: min(75rem, calc(100% - 4rem));
    max-width: 100%;
    margin-inline: auto;
    margin-bottom: 2rem;
    min-height: calc(100dvh - 4rem);
    padding: 2rem 1.5rem 3rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    background-color: color-mix(in srgb, #0a0a0a 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, #f5f5f5 10%, transparent);
    border-radius: 1rem;
    gap: 0;
  }

  .event-detail__card.event-detail__card--with-header {
    margin-top: 6.25rem;
  }

  @media (min-width: 56rem) {
    .event-detail__card.event-detail__card--with-header {
      margin-top: 8rem;
    }
  }

  .event-detail__masthead {
    min-width: 0;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, #f5f5f5 14%, transparent);
  }

  .event-detail__masthead h1 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.25;
  }

  .event-detail__grid {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
  }

  .event-detail__visual {
    margin: 0;
    display: flex;
    width: 100%;
    min-width: 0;
    min-height: 0;
  }

  .event-detail__visual-zoom {
    display: flex;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    text-align: inherit;
    color: inherit;
  }

  .event-detail__visual-zoom:focus-visible {
    outline: 2px solid #f2f0ef;
    outline-offset: 3px;
    border-radius: 0.75rem;
  }

  .event-detail__visual img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    max-height: min(70dvh, 42rem);
    object-fit: contain;
    object-position: center;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, #f5f5f5 18%, transparent);
  }

  .event-detail__description {
    min-width: 0;
  }

  .event-detail__meta {
    min-width: 0;
    width: 100%;
  }

  @media (min-width: 56rem) {
    .event-detail__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr) minmax(0, 17.5rem);
      column-gap: 2.25rem;
      row-gap: 0;
      align-items: start;
    }

    .event-detail__grid--no-poster {
      grid-template-columns: minmax(0, 1fr) minmax(0, 17.5rem);
    }

    .event-detail__masthead h1 {
      white-space: nowrap;
    }

    .event-detail__visual,
    .event-detail__meta {
      position: sticky;
      top: var(--event-detail-sticky-top);
      align-self: start;
      z-index: 1;
    }
  }

  @media (max-width: 55.99rem) {
    .event-detail__card {
      width: calc(100% - 1.5rem);
      margin-inline: auto;
      margin-bottom: 0.75rem;
      min-height: calc(100dvh - 1.5rem);
      padding: 1.25rem 1rem 2rem;
    }

    .event-detail__card.event-detail__card--with-header {
      margin-top: 5rem;
    }

    .event-detail__masthead {
      padding-bottom: 1rem;
      margin-bottom: 1.25rem;
    }

    .event-detail__masthead h1 {
      font-size: clamp(1.125rem, 5vw, 1.5rem);
      line-height: 1.2;
      overflow-wrap: anywhere;
    }
  }
</style>