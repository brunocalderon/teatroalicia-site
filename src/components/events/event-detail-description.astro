---
export interface Props {
  html: string
}
const { html } = Astro.props
---

<div class="event-detail__prose" set:html={html} />

<style>
  .event-detail__prose {
    font-size: 1rem;
    line-height: 1.55;
    color: color-mix(in srgb, #f5f5f5 85%, transparent);
  }

  .event-detail__prose :global(p) {
    margin: 0;
  }

  .event-detail__prose :global(p + p) {
    margin-top: 0.625rem;
  }

  .event-detail__prose :global(h1),
  .event-detail__prose :global(h2),
  .event-detail__prose :global(h3),
  .event-detail__prose :global(h4) {
    margin: 0;
    font-weight: 600;
    line-height: 1.25;
    color: #f2f0ef;
    letter-spacing: 0.02em;
  }

  .event-detail__prose :global(h3) {
    font-size: 1.25rem;
  }

  .event-detail__prose :global(h2) {
    font-size: 1.375rem;
  }

  .event-detail__prose :global(h1) {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .event-detail__prose :global(h4) {
    font-size: 1.0625rem;
  }

  .event-detail__prose :global(:is(h1, h2, h3, h4) + p) {
    margin-top: 0.625rem;
  }

  .event-detail__prose :global(ul),
  .event-detail__prose :global(ol) {
    margin: 0.625rem 0 0;
    padding-left: 1.5rem;
    list-style-position: outside;
    line-height: 1.55;
  }

  .event-detail__prose :global(ul) {
    list-style-type: disc;
  }

  .event-detail__prose :global(ol) {
    list-style-type: decimal;
  }

  .event-detail__prose :global(li) {
    display: list-item;
    margin-block: 0;
    padding-block: 0;
    padding-inline-start: 0.2rem;
  }

  .event-detail__prose :global(strong) {
    font-weight: 600;
    color: #f2f0ef;
  }
</style>