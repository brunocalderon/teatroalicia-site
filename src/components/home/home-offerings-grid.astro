---
import { formatHomeContentTemplate } from "@/lib/home-content-format"
import type { HomeContent } from "@/lib/home-content-schema"
import type { VenueConfig } from "@/lib/venue-schema"

interface Props {
  venue: VenueConfig
  home: HomeContent
}

const { venue, home } = Astro.props
const { amenities, contact, googleMapsUrl, address } = venue
const contactFormHref = contact.contactFormUrl
  ? new URL(contact.contactFormUrl).pathname
  : "/contacto"
const mapsBody = formatHomeContentTemplate(home.offerings.maps.body, {
  streetAddress: address.streetAddress,
  addressLocality: address.addressLocality,
})
const { offerings } = home
---

<section class="home-band home-band--offerings" aria-labelledby="home-offerings-title">
  <hr class="home-rule" />
  <div class="home-band__inner home-band__inner--wide">
    <p class="home-band__kicker">{home.offeringsSection.kicker}</p>
    <h2 id="home-offerings-title" class="home-band__title home-band__title--display">
      {home.offeringsSection.title}
    </h2>
    <div class="home-offerings">
      <article class="home-offering">
        <p class="home-offering__badge">{offerings.liveMusic.badge}</p>
        <h3 class="home-offering__title">{offerings.liveMusic.title}</h3>
        <p class="home-offering__body">{offerings.liveMusic.body}</p>
      </article>

      {
        amenities.barFood ? (
          <article class="home-offering">
            <p class="home-offering__badge">{offerings.barFood.badge}</p>
            <h3 class="home-offering__title">{offerings.barFood.title}</h3>
            <p class="home-offering__body">
              {amenities.barFoodDescription ?? offerings.barFood.bodyFallback}
            </p>
          </article>
        ) : null
      }

      <a
        class="home-offering home-offering--link"
        href={googleMapsUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        <p class="home-offering__badge">{offerings.maps.badge}</p>
        <h3 class="home-offering__title">{offerings.maps.title}</h3>
        <p class="home-offering__body">{mapsBody}</p>
        <span class="home-offering__cta">{offerings.maps.cta}</span>
      </a>

      {
        amenities.cloakroom ||
        amenities.parking ||
        amenities.smokingTerrace ? (
          <article class="home-offering">
            <p class="home-offering__badge">{offerings.amenities.badge}</p>
            <h3 class="home-offering__title">{offerings.amenities.title}</h3>
            <p class="home-offering__body">
              {[
                amenities.cloakroom ? "Guardarropía" : null,
                amenities.parking
                  ? (amenities.parkingDescription ?? "Estacionamiento cercano")
                  : null,
                amenities.smokingTerrace ? "Terraza Fumadores" : null,
              ]
                .filter(Boolean)
                .join(" · ")}
            </p>
          </article>
        ) : null
      }

      <a class="home-offering home-offering--link" href={contactFormHref}>
        <p class="home-offering__badge">{offerings.corporate.badge}</p>
        <h3 class="home-offering__title">{offerings.corporate.title}</h3>
        <p class="home-offering__body">{offerings.corporate.body}</p>
        <span class="home-offering__cta">{offerings.corporate.cta}</span>
      </a>

      <a class="home-offering home-offering--link" href={contactFormHref}>
        <p class="home-offering__badge">{offerings.private.badge}</p>
        <h3 class="home-offering__title">{offerings.private.title}</h3>
        <p class="home-offering__body">{offerings.private.body}</p>
        <span class="home-offering__cta">{offerings.private.cta}</span>
      </a>
    </div>
  </div>
</section>