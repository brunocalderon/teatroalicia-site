---
import HomeEventFeature, {
  type HomeEventFeatureData,
} from "@/components/home/home-event-feature.astro"
import HomeMarketingSlideshow from "@/components/home/home-marketing-slideshow.astro"
import type { HomeContent } from "@/lib/home-content-schema"
import type { HomeHeroSlideBackground } from "@/lib/home-marketing-image"

interface Props {
  events: HomeEventFeatureData[]
  home: HomeContent
  venueName: string
  instagramUrl?: string
  slideBackgrounds: HomeHeroSlideBackground[]
}

const { events, home, venueName, instagramUrl, slideBackgrounds } = Astro.props

const showCartelera = events.length > 0
const carteleraHasCarousel = events.length > 3
---

{
  showCartelera ? (
    <section
      id="cartelera"
      class="home-featured"
      aria-labelledby="home-featured-title"
    >
      <HomeMarketingSlideshow slideBackgrounds={slideBackgrounds} />
      <div class="home-featured__inner">
        <div class="home-featured__heading">
          <h2 id="home-featured-title" class="home-featured__heading-line">
            {home.cartelera.heading}
          </h2>
          <h1 class="home-featured__heading-line">{venueName}</h1>
        </div>
        {
          carteleraHasCarousel ? (
            <div class="home-featured__carousel" data-home-featured-carousel>
              <button
                type="button"
                class="home-featured__nav home-featured__nav--prev"
                data-home-featured-carousel-prev
                aria-label="Eventos anteriores"
                disabled
              >
                <span class="home-featured__nav-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m15 18-6-6 6-6" />
                  </svg>
                </span>
              </button>
              <div class="home-featured__viewport">
                <div
                  class="home-featured__list home-featured__list--carousel"
                  data-home-featured-carousel-track
                >
                  {events.map((event, index) => (
                    <HomeEventFeature event={event} enterIndex={index} />
                  ))}
                </div>
              </div>
              <button
                type="button"
                class="home-featured__nav home-featured__nav--next"
                data-home-featured-carousel-next
                aria-label="Siguientes eventos"
              >
                <span class="home-featured__nav-icon" aria-hidden="true">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </span>
              </button>
            </div>
          ) : (
            <div class="home-featured__list">
              {events.map((event, index) => (
                <HomeEventFeature event={event} enterIndex={index} />
              ))}
            </div>
          )
        }
      </div>
      <div
        class="home-poster-lightbox"
        data-cartelera-poster-lightbox
        hidden
        role="dialog"
        aria-modal="true"
        aria-labelledby="home-cartelera-poster-lightbox-label"
      >
        <p id="home-cartelera-poster-lightbox-label" class="sr-only">
          Afiche del evento
        </p>
        <p
          class="sr-only"
          data-cartelera-poster-lightbox-title
        />
        <button
          type="button"
          class="home-poster-lightbox__backdrop"
          data-cartelera-poster-lightbox-close
          aria-label="Cerrar afiche ampliado"
        />
        <div class="home-poster-lightbox__panel">
          <button
            type="button"
            class="home-poster-lightbox__close"
            data-cartelera-poster-lightbox-close
            aria-label="Cerrar"
          >
            Cerrar
          </button>
          <img
            class="home-poster-lightbox__image"
            data-cartelera-poster-lightbox-image
            alt=""
            decoding="async"
          />
        </div>
      </div>
    </section>
  ) : (
    <section
      id="cartelera"
      class="home-band home-band--empty"
      aria-labelledby="home-events-empty"
    >
      <hr class="home-rule" />
      <div class="home-band__inner">
        <h2 id="home-events-empty" class="home-band__title">
          {home.cartelera.emptyTitle}
        </h2>
        <p class="home-band__lead">{home.cartelera.emptyLead}</p>
        {instagramUrl ? (
          <a
            class="home-btn home-btn--outline"
            href={instagramUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {home.cartelera.emptyInstagramCta}
          </a>
        ) : null}
      </div>
    </section>
  )
}

<script>
  import { initCarteleraPosterLightbox } from "@/lib/cartelera-poster-lightbox"
  import { initHomeFeaturedCarousel } from "@/lib/home-featured-carousel"
  import {
    resolveTicketCheckoutDestination,
    trackMetaTicketCheckoutClick,
  } from "@/lib/meta-ticket-checkout"
  import { trackUmamiCarteleraTicketClick } from "@/lib/track-umami-cartelera-ticket"

  const cartelera = document.getElementById("cartelera")
  const carteleraRoot = cartelera ?? document
  initCarteleraPosterLightbox(carteleraRoot)
  initHomeFeaturedCarousel(carteleraRoot)

  const list = document.querySelector(".home-featured__list")
  type CarteleraTicketClickEvent = Event & {
    __metaTicketCheckoutTracked?: boolean
  }

  list?.addEventListener("click", (event) => {
    const clickEvent = event as CarteleraTicketClickEvent
    const target = (event.target as Element).closest<HTMLAnchorElement>(
      "[data-cartelera-ticket-cta]",
    )
    if (!target) {
      return
    }
    const eventTitle = target.dataset.eventTitle ?? ""
    const eventId =
      target.dataset.eventId?.trim() ||
      target.dataset.ticketContentId?.trim() ||
      target.dataset.eventCampaign ||
      ""
    trackUmamiCarteleraTicketClick({
      event_title: eventTitle,
      event_id: eventId,
    })

    if (clickEvent.__metaTicketCheckoutTracked) {
      return
    }
    clickEvent.__metaTicketCheckoutTracked = true

    const contentId =
      target.dataset.ticketContentId?.trim() ||
      target.dataset.eventId?.trim() ||
      target.dataset.eventCampaign ||
      "event"
    trackMetaTicketCheckoutClick({
      content_name: eventTitle,
      content_ids: [contentId],
      destination: resolveTicketCheckoutDestination(
        target.href,
        target.dataset.ticketSupplier,
      ),
    })
  })
</script>