---
import HomeEventFeature, {
  type HomeEventFeatureData,
} from "@/components/home/home-event-feature.astro"
import { Separator } from "@/components/ui/separator"
import type { HomeContent } from "@/lib/home-content-schema"

interface Props {
  events: HomeEventFeatureData[]
  home: HomeContent
  instagramUrl?: string
}

const { events, home, instagramUrl } = Astro.props
---

{
  events.length > 0 ? (
    <section
      id="cartelera"
      class="home-featured"
      aria-labelledby="home-featured-title"
    >
      <div class="home-featured__inner">
        <h2 id="home-featured-title" class="home-featured__heading">
          {home.cartelera.heading}
        </h2>
        {events.map((event, index) => (
          <>
            <HomeEventFeature event={{ ...event, reversed: index % 2 === 1 }} />
            {index < events.length - 1 ? (
              <Separator className="home-featured__event-separator" />
            ) : null}
          </>
        ))}
      </div>
    </section>
  ) : (
    <section
      id="cartelera"
      class="home-band home-band--empty"
      aria-labelledby="home-events-empty"
    >
      <hr class="home-rule" />
      <div class="home-band__inner">
        <h2 id="home-events-empty" class="home-band__title">
          {home.cartelera.emptyTitle}
        </h2>
        <p class="home-band__lead">{home.cartelera.emptyLead}</p>
        {instagramUrl ? (
          <a
            class="home-btn home-btn--outline"
            href={instagramUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {home.cartelera.emptyInstagramCta}
          </a>
        ) : null}
      </div>
    </section>
  )
}

<style>
  .home-featured__inner :global(.home-featured__event-separator) {
    display: block;
    flex-shrink: 0;
    width: min(17.5rem, 78vw);
    max-width: calc(100% - 2 * var(--home-gutter));
    height: 1px;
    margin: 0.25rem auto;
    border: 0;
    background: var(--home-line);
    opacity: 1;
  }

  @media (min-width: 56rem) {
    .home-featured__inner :global(.home-featured__event-separator) {
      display: none;
    }
  }
</style>