---
import type { VenueConfig } from "@/lib/venue-schema"

interface Props {
  venue: VenueConfig
}

const { venue } = Astro.props
const slogan = venue.slogan?.trim()
const locality = `${venue.address.addressLocality}, Chile`
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="home-hero__inner">
    <p class="home-hero__kicker">{locality}</p>
    <h1 id="home-hero-title" class="home-hero__title">
      {venue.name}
    </h1>
    {slogan ? <p class="home-hero__slogan">{slogan}</p> : null}
    <p class="home-hero__lead">{venue.description}</p>
  </div>
</section>