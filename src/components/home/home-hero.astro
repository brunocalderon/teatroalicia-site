---
import type { HomeContent } from "@/lib/home-content-schema"
import type { VenueConfig } from "@/lib/venue-schema"

interface Props {
  venue: VenueConfig
  home: HomeContent
  /** CSS `background-image` values (optimized WebP) per carousel slide. */
  slideBackgrounds: string[]
}

const { venue, home, slideBackgrounds } = Astro.props
const slogan = home.hero.slogan?.trim()
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__carousel" aria-hidden="true">
    {
      slideBackgrounds.map((backgroundImage) => (
        <div
          class="home-hero__slide"
          style={`--home-hero-image: ${backgroundImage}`}
        />
      ))
    }
  </div>
  <div class="home-hero__scrim" aria-hidden="true"></div>
  <div class="home-hero__inner">
    <p class="home-hero__kicker">{home.hero.kicker}</p>
    <h1 id="home-hero-title" class="home-hero__title">
      {venue.name}
    </h1>
    {slogan ? <p class="home-hero__slogan">{slogan}</p> : null}
    <p class="home-hero__lead">{home.hero.lead}</p>
  </div>
</section>