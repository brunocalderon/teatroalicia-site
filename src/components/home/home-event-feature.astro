---
import type { HomeEventFeatureData } from "@/lib/home-event-feature-data"

export type { HomeEventFeatureData } from "@/lib/home-event-feature-data"

interface Props {
  event: HomeEventFeatureData
  /** Stagger index for cartelera card entrance (0-based). */
  enterIndex?: number
}

const { event, enterIndex = 0 } = Astro.props
const posterAlt = event.imageAlt?.trim() || ""
const posterImage = event.image
const posterZoomSrc =
  posterImage?.zoomSrc ?? posterImage?.fallbackSrc ?? posterImage?.src
const posterUsesPicture = Boolean(
  posterImage?.fallbackSrc && posterImage.fallbackSrcSet,
)
const ctaLinkAttrs = event.ctaExternal
  ? { target: "_blank", rel: "noopener noreferrer" as const }
  : {}
---

<article
  class="home-feature"
  style={`--home-feature-enter-index: ${enterIndex}`}
>
  {
    event.image ? (
      <button
        type="button"
        class="home-feature__media"
        data-cartelera-poster-zoom
        data-zoom-src={posterZoomSrc}
        data-event-title={event.title}
        aria-label={`Ampliar afiche de ${event.title}`}
      >
        <div class="home-feature__poster-frame">
          <span
            class="home-feature__poster-skeleton"
            aria-hidden="true"
          />
          {posterUsesPicture && posterImage ? (
            <picture>
              <source
                type="image/webp"
                srcset={posterImage.srcSet}
                sizes={posterImage.sizes}
              />
              <img
                class="home-feature__image"
                src={posterImage.fallbackSrc}
                srcset={posterImage.fallbackSrcSet}
                sizes={posterImage.sizes}
                width={posterImage.width}
                height={posterImage.height}
                alt={posterAlt}
                loading="lazy"
                decoding="async"
              />
            </picture>
          ) : posterImage ? (
            <img
              class="home-feature__image"
              src={posterImage.src}
              srcset={posterImage.srcSet}
              sizes={posterImage.sizes}
              width={posterImage.width}
              height={posterImage.height}
              alt={posterAlt}
              loading="lazy"
              decoding="async"
            />
          ) : null}
        </div>
      </button>
    ) : (
      <div class="home-feature__media" aria-hidden="true">
        <div class="home-feature__placeholder" />
      </div>
    )
  }
  <div class="home-feature__content">
    <h2 class="home-feature__title">
      <a href={event.ctaHref} {...ctaLinkAttrs}>
        {event.title}
      </a>
    </h2>
    {event.dateLine ? <p class="home-feature__date">{event.dateLine}</p> : null}
    {event.timeLine ? <p class="home-feature__time">{event.timeLine}</p> : null}
  </div>
  <div class="home-feature__actions">
    <a
      class="home-btn home-btn--primary"
      href={event.ctaHref}
      {...ctaLinkAttrs}
      {...(event.ctaExternal
        ? {
            "data-cartelera-ticket-cta": true,
            "data-event-title": event.title,
            "data-event-id": event.eventId ?? "",
            "data-event-campaign": event.eventCampaign ?? "",
            "data-ticket-content-id": event.ticketContentId ?? "",
            "data-ticket-supplier": event.ticketSupplier ?? "",
          }
        : {})}
    >
      {
        event.ctaExternal ? (
          <span class="home-btn__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="home-btn__ticket-icon"
            >
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
              <path d="M13 5v2" />
              <path d="M13 17v2" />
              <path d="M13 11v2" />
            </svg>
          </span>
        ) : null
      }
      <span class="home-btn__label">{event.ctaLabel}</span>
    </a>
  </div>
</article>