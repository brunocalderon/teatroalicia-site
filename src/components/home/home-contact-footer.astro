---
import type { VenueConfig } from "@/lib/venue-schema"
import { instagramUrlFromVenue } from "@/lib/venue-social"

interface Props {
  venue: VenueConfig
}

const { venue } = Astro.props
const { address, contact, googleMapsUrl } = venue
const instagramUrl = instagramUrlFromVenue(venue)
const contactFormHref = contact.contactFormUrl
  ? new URL(contact.contactFormUrl).pathname
  : "/contacto"
---

<footer id="contacto" class="home-footer">
  <hr class="home-rule" />
  <div class="home-footer__inner">
    <p class="home-footer__venue">{venue.name}</p>
    <p class="home-footer__address">
      {address.streetAddress}, {address.postalCode}{" "}
      {address.addressLocality}, Chile
    </p>
    <nav class="home-footer__nav" aria-label="Contacto y redes">
      <a href={contactFormHref}>Contacto</a>
      <a href={googleMapsUrl} rel="noopener noreferrer" target="_blank">
        Cómo llegar
      </a>
      {instagramUrl ? (
        <a href={instagramUrl} rel="noopener noreferrer" target="_blank">
          Instagram
        </a>
      ) : null}
    </nav>
  </div>
</footer>