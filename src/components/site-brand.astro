---
/** Teatro Alicia mark on home, 404, and generated form routes. */

interface Props {
  align?: "center" | "start"
}

const { align = "center" } = Astro.props
---

<a
  href="/"
  class:list={["site-brand", align === "start" && "site-brand--start"]}
>
  <img
    src="/logo.svg"
    alt="Teatro Alicia"
    width="147"
    height="113"
    decoding="async"
  />
</a>

<style>
  .site-brand {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 0 0 1.75rem;
    text-decoration: none;
  }

  .site-brand img {
    display: block;
    height: 4.25rem;
    width: auto;
  }

  @media (max-width: 55.99rem) {
    .site-brand img {
      height: calc(4.25rem * 0.75);
    }
  }

  .site-brand--start {
    width: auto;
    margin-bottom: 0;
    justify-content: flex-start;
    flex-shrink: 0;
  }
</style>