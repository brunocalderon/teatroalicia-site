---
import { getCollection, getEntry } from "astro:content"

import FormThankYouPage from "@/components/forms/form-thank-you-page.astro"
import { loadInvitationFormEntries } from "@/lib/invitation-form-entries"
import { resolveInvitationFormData } from "@/lib/resolve-invitation-form-entry"
import {
  assertFormsCollectionIntegrity,
  type FormEntryData,
} from "@/lib/form-schema"
import type { InvitationContentCollection } from "@/lib/invitation-form-entries"
import {
  DEFAULT_THANK_YOU_BODY,
  parseThankYouParagraphs,
  thankYouRouteParams,
} from "@/lib/form-thank-you"
import { thankYouFormTracking } from "@/lib/marketing-page-tracking"
import { renderFormBodyMarkdown } from "@/lib/render-form-body-markdown"
import { isGuestPassPromoterLinksPath } from "@/lib/guest-pass-promoter-link"

const thankYouFormBasePath = Astro.params.formBasePath ?? ""
const thankYouSlugParam = Astro.params.thankYouSlug ?? ""
const thankYouRequestPath = `/${thankYouFormBasePath}/${thankYouSlugParam}`
if (isGuestPassPromoterLinksPath(thankYouRequestPath)) {
  return Astro.rewrite(thankYouRequestPath)
}

export async function getStaticPaths() {
  const forms = await getCollection("forms")
  const invitationEntries = await loadInvitationFormEntries(forms)
  assertFormsCollectionIntegrity(
    invitationEntries.map((entry) => ({ id: entry.id, data: entry.data })),
  )

  return invitationEntries
    .filter((entry) => entry.data.guestListClosed !== true)
    .map((entry) => {
      const { formBasePath, thankYouSlug } = thankYouRouteParams(
        entry.data.path,
        entry.data.thankYouPath,
      )

      return {
        params: { formBasePath, thankYouSlug },
        props: {
          collection: entry.collection,
          entryId: entry.id,
          data: entry.data,
        },
      }
    })
}

type Props = {
  collection: InvitationContentCollection
  entryId: string
  data: FormEntryData
}

const { collection, entryId, data: dataFromProps } = Astro.props as Props
const data = await resolveInvitationFormData(collection, entryId, dataFromProps)

const thankYouBody = data.messages?.thankYouBody ?? DEFAULT_THANK_YOU_BODY
const thankYouParagraphs = parseThankYouParagraphs(thankYouBody)
const thankYouParagraphsHtml = await Promise.all(
  thankYouParagraphs.map((paragraph) => renderFormBodyMarkdown(paragraph))
)
const thankYouTitle = data.messages?.thankYouTitle ?? data.title
const showThankYouInstagram =
  data.thankYouInstagram !== false && data.path.trim() !== "/contacto"
---

<FormThankYouPage
  title={thankYouTitle}
  lang={data.lang}
  paragraphsHtml={thankYouParagraphsHtml}
  marketingTracking={thankYouFormTracking(data.title, data.eventId)}
  thankYouInstagram={showThankYouInstagram}
/>