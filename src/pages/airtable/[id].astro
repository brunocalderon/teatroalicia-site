---
import Layout from "@/layouts/Layout.astro"
import {
  parseAirtableRecordFields,
  type AirtableRecordData,
} from "@/lib/airtable-record-schema"
import { loadAirtableBrowseRecords } from "@/lib/load-airtable-browse-records"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"

import "@/styles/airtable-browse.css"

export async function getStaticPaths() {
  const records = await loadAirtableBrowseRecords()
  return records.map((record) => ({
    params: { id: record.slug },
    props: { record },
  }))
}

type Props = {
  record: AirtableRecordData
}

const { record } = Astro.props as Props
const { slug, airtableRecordId, createdTime, fieldsJson, imagePath, imageAlt } =
  record

const fields = parseAirtableRecordFields({ fieldsJson })

const jsonPayload = {
  slug,
  airtableRecordId,
  ...(createdTime ? { createdTime } : {}),
  fields,
}

const backdropCss = sitePageBackdropCss("airtable-browse")
const pageTitle = `${slug} — Airtable — Teatro Alicia`
---

<Layout title={pageTitle} lang="es" deferredSiteBackdrop>
  <main class="airtable-browse">
    <p class="airtable-browse__crumb">
      <a href="/airtable">Airtable</a>
      <span aria-hidden="true"> / </span>
      <span>{slug}</span>
    </p>
    {
      imagePath ? (
        <figure class="airtable-browse__figure">
          <img
            class="airtable-browse__image"
            src={imagePath}
            alt={imageAlt ?? slug}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ) : null
    }
    <pre class="airtable-browse__json"><code>{JSON.stringify(jsonPayload, null, 2)}</code></pre>
    <a class="airtable-browse__back" href="/airtable">Volver al listado</a>
  </main>
</Layout>

<style is:global set:html={backdropCss}></style>