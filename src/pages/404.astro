---
import SiteBrand from "@/components/site-brand.astro"
import Layout from "@/layouts/Layout.astro"
import { marketingPageTracking } from "@/lib/marketing-page-tracking"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"

const title = "Página no encontrada"
const description =
  "La página que buscas no existe o ya no está disponible en Teatro Alicia."

const notFoundBackdropCss = sitePageBackdropCss("not-found-page")
---

<Layout
  title={title}
  description={description}
  lang="es"
  tracking={marketingPageTracking.home}
  deferredSiteBackdrop
>
  <main class="not-found-page">
    <div class="not-found-page__content">
      <SiteBrand />
      <header class="not-found-page__header">
        <p class="not-found-page__code" aria-hidden="true">404</p>
        <h1>{title}</h1>
        <p class="not-found-page__lead">
          Revisa la dirección o vuelve al inicio para seguir navegando.
        </p>
      </header>
      <a class="not-found-page__cta" href="/">Volver al inicio</a>
    </div>
  </main>
</Layout>

<style is:global set:html={notFoundBackdropCss}></style>

<style>
  .not-found-page {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 100dvh;
    padding: 2rem 1.5rem;
    background-color: color-mix(in srgb, #0a0a0a 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .not-found-page__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    max-width: 28rem;
    text-align: center;
  }

  .not-found-page__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .not-found-page__code {
    margin: 0;
    font-size: clamp(3rem, 12vw, 4.5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, #f5f5f5 35%, transparent);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #f5f5f5;
  }

  .not-found-page__lead {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: color-mix(in srgb, #f5f5f5 78%, transparent);
  }

  .not-found-page__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.5rem;
    border: 1px solid color-mix(in srgb, #f5f5f5 35%, transparent);
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: #f5f5f5;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .not-found-page__cta:hover {
    background-color: color-mix(in srgb, #f5f5f5 8%, transparent);
    border-color: color-mix(in srgb, #f5f5f5 55%, transparent);
  }

  .not-found-page__cta:focus-visible {
    outline: 2px solid #f5f5f5;
    outline-offset: 3px;
  }
</style>