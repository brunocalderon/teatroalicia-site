---
import { getCollection } from "astro:content"

import HomeContactFooter from "@/components/home/home-contact-footer.astro"
import type { HomeEventFeatureData } from "@/components/home/home-event-feature.astro"
import HomeEventsSection from "@/components/home/home-events-section.astro"
import HomeHeader from "@/components/home/home-header.astro"
import HomeOfferingsGrid from "@/components/home/home-offerings-grid.astro"
import HomeVenueSection from "@/components/home/home-venue-section.astro"
import Layout from "@/layouts/Layout.astro"
import { resolveEventInvitationPath } from "@/lib/event-schema"
import { formatEventSchedule } from "@/lib/format-event-display"
import { buildCarteleraPosterFeatureImage } from "@/lib/airtable-cartelera/build-cartelera-poster-feature-image"
import { carteleraPosterImageBySlug } from "@/lib/airtable-cartelera/cartelera-poster-image-modules"
import {
  buildHomeEventFeatureImage,
  type HomeEventFeatureImage,
} from "@/lib/home-event-feature-image"
import {
  buildHomeHeroSlideBackground,
  buildHomeVenuePhotoImage,
  HOME_HERO_SLIDE_PATHS,
} from "@/lib/home-marketing-image"
import { fetchAirtableCarteleraRows } from "@/lib/airtable-cartelera/fetch-events"
import {
  airtableCarteleraRowsToApiEvents,
  filterUpcomingAirtableCarteleraRows,
} from "@/lib/airtable-cartelera/to-api-events"
import { airtableRowToEventEntryData } from "@/lib/airtable-cartelera/to-event-entry"
import { resolveAirtableCarteleraConfig } from "@/lib/airtable-env"
import { getUpcomingEventEntries } from "@/lib/home-upcoming-events"
import {
  hasBundledFormEventImage,
  resolveFormEventImageSource,
} from "@/lib/form-event-image"
import { resolveVenuePrimaryImageAbsoluteUrl } from "@/lib/venue-primary-image"
import {
  appendHomeCarteleraUtm,
  homeCarteleraEventSlug,
} from "@/lib/home-cartelera-utm"
import { resolvePublicTicketUrl } from "@/lib/form-schema"
import { marketingPageTracking } from "@/lib/marketing-page-tracking"
import { CANONICAL_SITE_ORIGIN } from "@/lib/schema-org/canonical-origin"
import { buildHomePageJsonLd } from "@/lib/schema-org/build-home-json-ld"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"
import { instagramUrlFromVenue } from "@/lib/venue-social"
import { homeContent } from "../../content/home"
import { venueConfig } from "../../content/venue"

import "@/styles/home.css"

const pageTitle = homeContent.meta.title
const pageDescription = homeContent.meta.description

const airtableCarteleraConfig = resolveAirtableCarteleraConfig()
const useAirtableCartelera = Boolean(airtableCarteleraConfig)

const events = await getCollection("events")
const upcomingEntries = useAirtableCartelera
  ? []
  : getUpcomingEventEntries(events)

const heroSlideBackgrounds = await Promise.all(
  HOME_HERO_SLIDE_PATHS.map((path) =>
    buildHomeHeroSlideBackground(resolveFormEventImageSource(path)),
  ),
)

let venuePhoto: Awaited<ReturnType<typeof buildHomeVenuePhotoImage>> | undefined
const venueImagePath = venueConfig.imagePath?.trim()
if (venueImagePath && hasBundledFormEventImage(venueImagePath)) {
  venuePhoto = await buildHomeVenuePhotoImage(
    resolveFormEventImageSource(venueImagePath),
  )
}

const venueImageUrl = await resolveVenuePrimaryImageAbsoluteUrl()

const eventImageUrlBySlug: Record<string, string | undefined> = {}
let eventFeatures: HomeEventFeatureData[] = []
let upcomingEventsForSchema = events.map((entry) => ({
  id: entry.id,
  data: entry.data,
}))

if (useAirtableCartelera && airtableCarteleraConfig) {
  const airtableRows = await fetchAirtableCarteleraRows(airtableCarteleraConfig)
  const upcomingRows = filterUpcomingAirtableCarteleraRows(airtableRows)
  const imagesBySlug = new Map<string, HomeEventFeatureImage>()
  for (const row of airtableRows) {
    const source = await carteleraPosterImageBySlug(row.slug)
    if (!source) {
      continue
    }
    const image = await buildCarteleraPosterFeatureImage(source)
    imagesBySlug.set(row.slug, image)
    eventImageUrlBySlug[row.slug] = new URL(
      image.src,
      CANONICAL_SITE_ORIGIN,
    ).href
  }

  eventFeatures = await airtableCarteleraRowsToApiEvents(airtableRows, {
    imagesBySlug,
  })

  upcomingEventsForSchema = upcomingRows.map((row) => ({
    id: row.slug,
    data: airtableRowToEventEntryData(row),
  }))
} else {
  for (const entry of upcomingEntries) {
    const { data } = entry
    const schedule = data.eventStart
      ? formatEventSchedule(data.eventStart, data.eventEnd, { date: "home" })
      : { dateLine: "", timeLine: "" }

    let image: Awaited<ReturnType<typeof buildHomeEventFeatureImage>> | undefined
    if (data.image && hasBundledFormEventImage(data.image)) {
      const source = resolveFormEventImageSource(data.image)
      image = await buildHomeEventFeatureImage(source)
      eventImageUrlBySlug[data.slug] = new URL(
        image.src,
        CANONICAL_SITE_ORIGIN,
      ).href
    }

    const ticketUrl = resolvePublicTicketUrl(data)
    const invitationPath = data.invitation
      ? resolveEventInvitationPath(data)
      : undefined
    const baseCtaHref = ticketUrl ?? invitationPath ?? "#"
    const ctaHref = appendHomeCarteleraUtm(
      baseCtaHref,
      homeCarteleraEventSlug(data),
    )
    const ctaLabel = ticketUrl
      ? "Comprar tickets"
      : data.invitation?.submitLabel?.trim() || "Solicitar acceso"
    eventFeatures.push({
      title: data.title,
      ctaHref,
      ctaExternal: Boolean(ticketUrl),
      eventCampaign: homeCarteleraEventSlug(data),
      ctaLabel,
      dateLine: schedule.dateLine,
      timeLine: schedule.timeLine,
      imageAlt: data.imageAlt,
      image,
    })
  }
}

const homeJsonLd = buildHomePageJsonLd({
  venue: venueConfig,
  pageTitle: venueConfig.name,
  pageDescription: venueConfig.description,
  upcomingEvents: upcomingEventsForSchema,
  eventImageUrlBySlug,
  venueImageUrl,
})

const instagramUrl = instagramUrlFromVenue(venueConfig)

const showCarteleraHero = eventFeatures.length > 0
const homePageBackdropCss = sitePageBackdropCss("home-page", {
  primaryHeroBackground: showCarteleraHero,
})
const firstHeroSlide = heroSlideBackgrounds[0]
const heroBackgroundPreload =
  showCarteleraHero && firstHeroSlide
    ? {
        src: firstHeroSlide.preloadSrc,
        srcSet: firstHeroSlide.preloadSrcSet,
        sizes: firstHeroSlide.preloadSizes,
      }
    : undefined
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang="es"
  tracking={marketingPageTracking.home}
  deferredSiteBackdrop={!showCarteleraHero}
  heroBackgroundPreload={heroBackgroundPreload}
  jsonLd={homeJsonLd}
>
  <HomeHeader />
  <main class="home-page">
    <HomeEventsSection
      events={eventFeatures}
      home={homeContent}
      venueName={venueConfig.name}
      instagramUrl={instagramUrl}
      slideBackgrounds={heroSlideBackgrounds}
    />
    <HomeVenueSection
      venue={venueConfig}
      home={homeContent}
      venuePhoto={venuePhoto}
    />
    <HomeOfferingsGrid venue={venueConfig} home={homeContent} />
    <HomeContactFooter venue={venueConfig} />
  </main>
</Layout>

<style is:global set:html={homePageBackdropCss}></style>