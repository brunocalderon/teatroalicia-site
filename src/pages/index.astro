---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<h1>Coming soon</h1>
	</main>
</Layout>

<style>
	main {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100dvh;
		padding: 1.5rem;
		box-sizing: border-box;
	}

	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 5vw, 2.5rem);
		font-weight: 400;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #f5f5f5;
	}
</style>
