---
import { venueConfig } from "../../content/venue"
import SiteBrand from "@/components/site-brand.astro"
import Layout from "@/layouts/Layout.astro"
import { marketingPageTracking } from "@/lib/marketing-page-tracking"
import { buildHomePageJsonLd } from "@/lib/schema-org/build-home-json-ld"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"

const homePageBackdropCss = sitePageBackdropCss("home-page")
const homeDescription = venueConfig.description
const homeJsonLd = buildHomePageJsonLd({
  venue: venueConfig,
  pageTitle: "Teatro Alicia",
  pageDescription: homeDescription,
})
---

<Layout
  title="Teatro Alicia"
  description={homeDescription}
  lang="es"
  tracking={marketingPageTracking.home}
  deferredSiteBackdrop
  jsonLd={homeJsonLd}
>
  <main class="home-page">
    <div class="home-page__content">
      <SiteBrand />
      <h1>Pronto</h1>
    </div>
  </main>
</Layout>

<style is:global set:html={homePageBackdropCss}></style>

<style>
  .home-page {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 100dvh;
    padding: 2rem 1.5rem;
    background-color: color-mix(in srgb, #0a0a0a 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .home-page__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f5f5f5;
  }
</style>