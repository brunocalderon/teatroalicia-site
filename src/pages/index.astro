---
import FormSiteBrand from "@/components/forms/form-site-brand.astro"
import Layout from "@/layouts/Layout.astro"
import { FORM_PAGE_BACKGROUND_HD_IMAGE_SET } from "@/lib/form-page-background"
import { marketingPageTracking } from "@/lib/marketing-page-tracking"
---

<Layout tracking={marketingPageTracking.home}>
  <main class="home-page">
    <div class="home-page__content">
      <FormSiteBrand />
      <h1>Coming soon</h1>
    </div>
  </main>
</Layout>

<style define:vars={{ formPageBgHd: FORM_PAGE_BACKGROUND_HD_IMAGE_SET }}>
  :global(body:has(.home-page)) {
    position: relative;
    background-color: transparent;
    min-height: 100dvh;
  }

  :global(body:has(.home-page)::before) {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    background-color: #000;
    background-image: var(--form-page-bg-hd);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .home-page {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 100dvh;
    padding: 2rem 1.5rem;
    background-color: color-mix(in srgb, #0a0a0a 80%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .home-page__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f5f5f5;
  }
</style>