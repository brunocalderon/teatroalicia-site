---
import { getCollection, render, type CollectionEntry } from "astro:content"

import HomeHeader from "@/components/home/home-header.astro"
import Layout from "@/layouts/Layout.astro"
import {
  findCmsPathCollisions,
  findDuplicateCmsPaths,
} from "@/lib/cms-page-path-collisions"
import { readFormPathsFromMarkdown } from "@/lib/form-markdown-dirs"
import type { MarketingPageTracking } from "@/lib/marketing-page-tracking"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"

import "@/styles/cms-page.css"

export async function getStaticPaths() {
  const entries = await getCollection("cmsPages")
  const paths = entries.map((entry) => entry.data.path)
  const reserved = ["/", ...readFormPathsFromMarkdown()]

  const collisions = findCmsPathCollisions(paths, reserved)
  if (collisions.length > 0) {
    throw new Error(
      `cmsPages path collision with existing routes: ${collisions.join(", ")}`,
    )
  }

  const duplicates = findDuplicateCmsPaths(paths)
  if (duplicates.length > 0) {
    throw new Error(
      `cmsPages duplicate path values: ${duplicates.join(", ")}`,
    )
  }

  return entries.map((entry) => ({
    params: { cmsPath: entry.data.path.replace(/^\//, "") },
    props: { entry },
  }))
}

type Props = {
  entry: CollectionEntry<"cmsPages">
}

const { entry } = Astro.props as Props
const { data } = entry

const { Content } = await render(entry)

const pageTitle = `${data.title} — Teatro Alicia`
const description =
  data.description?.trim() || `${data.title} en Teatro Alicia.`
const cmsPageBackdropCss = sitePageBackdropCss("cms-page")

const tracking: MarketingPageTracking = {
  contentName: data.title,
  contentCategory: "Marketing",
  pageType: "CMS Page",
}
---

<Layout
  title={pageTitle}
  description={description}
  lang={data.lang}
  tracking={tracking}
  deferredSiteBackdrop
>
  <main class="cms-page">
    <header class="cms-page__header">
      <HomeHeader carteleraHref="/#cartelera" />
      <h1 class="cms-page__title">{data.title}</h1>
    </header>
    {data.body.trim().length > 0 ? (
      <div class="cms-page__body">
        <Content />
      </div>
    ) : null}
    <a class="cms-page__back" href="/">Volver al inicio</a>
  </main>
</Layout>

<style is:global set:html={cmsPageBackdropCss}></style>