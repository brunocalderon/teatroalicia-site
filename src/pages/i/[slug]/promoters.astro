---
import { getCollection } from "astro:content"

import PromoterLinksPage from "@/components/promoters/promoter-links-page.astro"
import { guestPassPromoterLinkRows } from "@/lib/guest-pass-promoter-link"
import { assertFormsCollectionIntegrity } from "@/lib/form-schema"
import { isGuestPassInvitationPath } from "@/lib/guest-pass-referral-field"
import { invitationSlugFromPath } from "@/lib/invitation-bundled-poster"
import {
  loadInvitationFormEntries,
  type InvitationContentCollection,
} from "@/lib/invitation-form-entries"
import { resolveInvitationFormData } from "@/lib/resolve-invitation-form-entry"
import type { FormEntryData } from "@/lib/form-schema"

export async function getStaticPaths() {
  const forms = await getCollection("forms")
  const invitationEntries = await loadInvitationFormEntries(forms)
  assertFormsCollectionIntegrity(
    invitationEntries.map((entry) => ({ id: entry.id, data: entry.data })),
  )

  return invitationEntries
    .filter((entry) => isGuestPassInvitationPath(entry.data.path))
    .map((entry) => {
      const slug = invitationSlugFromPath(entry.data.path)
      if (!slug) {
        throw new Error(
          `Guest-pass path missing slug: ${entry.data.path} (${entry.id})`,
        )
      }
      return {
        params: { slug },
        props: {
          collection: entry.collection,
          entryId: entry.id,
          data: entry.data,
        },
      }
    })
}

type Props = {
  collection: InvitationContentCollection
  entryId: string
  data: FormEntryData
}

const { collection, entryId, data: dataFromProps } = Astro.props as Props
/** Same title as guest-list pages: Airtable `Event Name` → `FormEntryData.title`. */
const data = await resolveInvitationFormData(collection, entryId, dataFromProps)
const lang = data.lang ?? "es"
const eventDisplayTitle = data.title
const pageTitle =
  lang === "es"
    ? `Links RRPPs · ${eventDisplayTitle}`
    : `Promoter links · ${eventDisplayTitle}`
const pageDescription =
  lang === "es"
    ? `Links para RRPPs · ${eventDisplayTitle}.`
    : `Promoter links · ${eventDisplayTitle}.`
const heading =
  lang === "es"
    ? `Links RRPPs: ${eventDisplayTitle}`
    : `Promoter links: ${eventDisplayTitle}`

const promoters = guestPassPromoterLinkRows(data.path)
---

<PromoterLinksPage
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  lang={lang}
  heading={heading}
  promoters={promoters}
/>