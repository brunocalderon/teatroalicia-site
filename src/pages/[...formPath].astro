---
import { getCollection, getEntry, render } from "astro:content"

import { renderFormBodyMarkdown } from "@/lib/render-form-body-markdown"

import { ConfigurableForm } from "@/components/forms/configurable-form"
import FormLivestackBrand from "@/components/forms/form-livestack-brand.astro"
import FormPageSkeleton from "@/components/forms/form-page-skeleton.astro"
import SiteBrand from "@/components/site-brand.astro"
import FormPageIntro from "@/components/forms/form-page-intro.astro"
import HomeHeader from "@/components/home/home-header.astro"
import Layout from "@/layouts/Layout.astro"
import { resolveFormEventImageSource } from "@/lib/form-event-image"
import { buildFormSplitVisualImage } from "@/lib/form-split-visual-image"
import {
  collectInvitationFormEntries,
  type InvitationContentCollection,
} from "@/lib/invitation-form-entries"
import { resolveInvitationFormData } from "@/lib/resolve-invitation-form-entry"
import {
  assertFormsCollectionIntegrity,
  defaultNameFields,
  formMetaDescription,
  warnFormSchemaOrgFields,
} from "@/lib/form-schema"
import type { FormEntryData } from "@/lib/form-schema"
import { CANONICAL_SITE_ORIGIN } from "@/lib/schema-org/canonical-origin"
import { buildInvitationPageJsonLd } from "@/lib/schema-org/build-invitation-page-json-ld"
import { venueConfig } from "../../content/venue"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"
import { MARKETING_ENGAGE_MS } from "astro:env/client"

import { invitationFormTracking } from "@/lib/marketing-page-tracking"

export async function getStaticPaths() {
  const forms = await getCollection("forms")
  const events = await getCollection("events")
  const invitationEntries = collectInvitationFormEntries(forms, events)
  assertFormsCollectionIntegrity(
    invitationEntries.map((entry) => ({ id: entry.id, data: entry.data })),
  )

  warnFormSchemaOrgFields(
    invitationEntries.map((entry) => ({ id: entry.id, data: entry.data })),
  )

  return invitationEntries.map((entry) => ({
    params: { formPath: entry.data.path.replace(/^\//, "") },
    props: {
      collection: entry.collection,
      entryId: entry.id,
      data: entry.data,
    },
  }))
}

type Props = {
  collection: InvitationContentCollection
  entryId: string
  data: FormEntryData
}

const { collection, entryId, data: dataFromProps } = Astro.props as Props
/** Re-fetch so dev picks up new frontmatter without a full server restart. */
const data = await resolveInvitationFormData(collection, entryId, dataFromProps)
const hasReferralField = data.fields.some((field) => field.type === "referral")

const formBodyMarkdown = data.messages?.formBody?.trim()
const formBodyHtml = formBodyMarkdown
  ? await renderFormBodyMarkdown(formBodyMarkdown)
  : undefined

let renderedBody: Awaited<ReturnType<typeof render>> | null = null
if (!formBodyMarkdown && collection === "forms") {
  const formEntry = await getEntry("forms", entryId)
  const legacyBody =
    formEntry && "body" in formEntry && typeof formEntry.body === "string"
      ? formEntry.body.trim()
      : ""
  if (legacyBody && formEntry) {
    renderedBody = await render(formEntry)
  }
}

const showFormIntro = Boolean(formBodyHtml || renderedBody)

const nameFields = data.nameFields ?? defaultNameFields(data.fields)

let formLcpImage: Awaited<
  ReturnType<typeof buildFormSplitVisualImage>
> | undefined
if (data.image) {
  const source = resolveFormEventImageSource(data.image)
  formLcpImage = await buildFormSplitVisualImage(source)
}

const tracking = invitationFormTracking(data.title)
const formDescription = formMetaDescription(data)

const eventImageUrl = formLcpImage
  ? new URL(formLcpImage.src, CANONICAL_SITE_ORIGIN).href
  : undefined
const formJsonLd = buildInvitationPageJsonLd({
  venue: venueConfig,
  data,
  pageTitle: data.title,
  pageDescription: formDescription,
  imageUrl: eventImageUrl,
})

const formPageBackdropCss = sitePageBackdropCss("form-page")
const showHomeNav = data.path === "/contacto"
---

<Layout
  title={data.title}
  description={formDescription}
  lang={data.lang}
  tracking={tracking}
  formThirdPartyHints
  lcpImage={formLcpImage}
  marketingEngageAfterLoadMs={MARKETING_ENGAGE_MS}
  jsonLd={formJsonLd}
>
    {
      hasReferralField ? (
        <>
          <style
            is:inline
            set:html={`.form-fieldset > .form-field.form-field--referral{display:none}html.has-guest-pass-ref .form-fieldset > .form-field.form-field--referral{display:flex;height:2.625rem;min-height:2.625rem;max-height:2.625rem}html.has-guest-pass-ref .form-referral-item{box-sizing:border-box;height:2.625rem;max-height:2.625rem;overflow:hidden;flex-wrap:nowrap}`}
          />
          <script
            is:inline
            set:html={`(function(){var e=(new URLSearchParams(location.search).get("e")||"").trim();if(e)document.documentElement.classList.add("has-guest-pass-ref");})();`}
          />
        </>
      ) : null
    }
    {
      showHomeNav ? (
        <HomeHeader carteleraHref="/#cartelera" />
      ) : null
    }
    <main
      class:list={[
        "form-page",
        data.image && "form-page--split",
        showHomeNav && "form-page--with-home-nav",
      ]}
    >
      <div class:list={[data.image ? "form-page__split" : "form-page__stack"]}>
        {data.image ? (
          <>
            <div class="form-page__masthead form-page__split-masthead">
              <SiteBrand align="start" />
              <header class="form-page__header">
                <h1>{data.title}</h1>
              </header>
            </div>
            <div class="form-page__split-lead">
              <figure class="form-page__visual form-page__split-visual">
                {
                  formLcpImage ? (
                    <img
                      src={formLcpImage.src}
                      srcset={formLcpImage.srcSet}
                      sizes={formLcpImage.sizes}
                      alt={data.imageAlt ?? data.title}
                      width={formLcpImage.width}
                      height={formLcpImage.height}
                      loading="eager"
                      fetchpriority="high"
                      decoding="sync"
                    />
                  ) : null
                }
              </figure>
              {
                showFormIntro ? (
                  <FormPageIntro
                    formBodyHtml={formBodyHtml}
                    renderedBody={renderedBody?.Content ?? null}
                    split
                  />
                ) : null
              }
            </div>
          </>
        ) : (
          <>
            <div class="form-page__masthead">
              {showHomeNav ? null : <SiteBrand align="start" />}
              <header class="form-page__header">
                <h1>{data.title}</h1>
              </header>
            </div>
            {
              showFormIntro ? (
                <FormPageIntro
                  formBodyHtml={formBodyHtml}
                  renderedBody={renderedBody?.Content ?? null}
                />
              ) : null
            }
          </>
        )}
        <div
          class:list={[
            "form-page__panel",
            data.image && "form-page__split-panel",
          ]}
        >
          <div class="form-page__form">
            <ConfigurableForm
              client:visible={{ rootMargin: "200px" }}
              token={data.token}
              fields={data.fields}
              lang={data.lang}
              submitLabel={data.submitLabel}
              thankYouPath={data.thankYouPath}
              eventId={data.eventId}
              nameFields={nameFields}
              messages={data.messages}
              marketingTracking={tracking}
            >
              <FormPageSkeleton
                slot="fallback"
                fields={data.fields}
                lang={data.lang}
              />
            </ConfigurableForm>
          </div>
        </div>
      </div>
      {data.livestackFooter ? <FormLivestackBrand /> : null}
    </main>
    <script
      is:inline
      set:html={`window.addEventListener("load",function(){var t=document.createElement("script");t.src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";t.async=true;t.defer=true;document.body.appendChild(t);var f=document.createElement("script");f.src="https://formgong.com/fg.js";f.async=true;document.body.appendChild(f);},{once:true});`}
    />
</Layout>

<style is:global set:html={formPageBackdropCss}></style>

<style>
  .form-page {
    width: min(75rem, calc(100% - 4rem));
    max-width: 100%;
    margin-block: 2rem;
    margin-inline: auto;
    min-height: calc(100dvh - 4rem);
    padding: 2rem 1.5rem 3rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    background-color: color-mix(in srgb, #0a0a0a 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, #f5f5f5 10%, transparent);
    border-radius: 1rem;
  }

  .form-page__split {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
  }

  .form-page__split-lead {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  /* Mobile masthead spacing is set in the max-width breakpoint. Desktop uses `row-gap: 2rem`. */

  @media (min-width: 56rem) {
    .form-page--split .form-page__split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-rows: auto auto;
      column-gap: 3rem;
      row-gap: 2rem;
      align-content: start;
      align-items: start;
    }

    .form-page--split .form-page__split-masthead {
      grid-column: 1 / -1;
      grid-row: 1;
      margin-top: 0;
      margin-bottom: 0;
    }

    .form-page--split .form-page__split-masthead h1 {
      white-space: nowrap;
    }

    .form-page__split-lead {
      grid-column: 1;
      grid-row: 2;
      align-self: start;
    }

    .form-page__split-panel {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      content-visibility: auto;
      contain-intrinsic-size: auto 720px;
    }
  }

  @media (max-width: 55.99rem) {
    .form-page {
      width: calc(100% - 1.5rem);
      margin-block: 0.75rem;
      margin-inline: auto;
      min-height: calc(100dvh - 1.5rem);
      padding: 1.25rem 1rem 2rem;
    }

    .form-page.form-page--split {
      padding-top: 1rem;
    }

    .form-page--split .form-page__split-masthead {
      flex-direction: row;
      align-items: center;
      gap: 0.875rem 1rem;
      margin-top: 0;
      margin-bottom: 1rem;
    }

    .form-page--split .form-page__split-panel {
      margin-top: 0.75rem;
    }

    .form-page--split .form-page__split-masthead h1 {
      font-size: clamp(1.125rem, 5vw, 1.5rem);
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .form-page__visual img {
      width: 100%;
      height: auto;
    }

    .form-page__split-panel,
    .form-page__form {
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
  }

  .form-page__masthead {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem 1.5rem;
    min-width: 0;
    margin-bottom: 0;
  }

  .form-page__masthead .form-page__header {
    flex: 1;
    min-width: 0;
  }

  .form-page__masthead h1 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.25;
  }

  .form-page--split .form-page__masthead h1 {
    margin-bottom: 0;
  }

  .form-page__visual {
    margin: 0;
    display: flex;
    width: 100%;
    min-height: 0;
  }

  .form-page__visual img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    max-height: min(70dvh, 42rem);
    object-fit: contain;
    object-position: center;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, #f5f5f5 18%, transparent);
  }

  .form-page__panel {
    min-width: 0;
  }

  .form-page__form {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    container-type: inline-size;
    container-name: form-panel;
  }

  .form-page__stack {
    display: block;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
  }

  .form-page:not(.form-page--split) {
    max-width: 52rem;
  }

  .form-page--with-home-nav {
    margin-top: calc(2rem + 4.25rem);
  }

  @media (min-width: 56rem) {
    .form-page--with-home-nav {
      margin-top: calc(2rem + 4.75rem);
    }
  }

  .form-page__header h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .form-page__masthead .form-page__header h1 {
    margin: 0;
  }
</style>
