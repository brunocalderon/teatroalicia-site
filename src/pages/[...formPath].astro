---
import { getCollection, getEntry, render } from "astro:content"

import { ConfigurableForm } from "@/components/forms/configurable-form"
import { ThankYouBody } from "@/components/forms/thank-you-body"
import FormLivestackBrand from "@/components/forms/form-livestack-brand.astro"
import FormPageSkeleton from "@/components/forms/form-page-skeleton.astro"
import SiteBrand from "@/components/site-brand.astro"
import Layout from "@/layouts/Layout.astro"
import { resolveFormEventImageSource } from "@/lib/form-event-image"
import { buildFormSplitVisualImage } from "@/lib/form-split-visual-image"
import {
  assertFormsCollectionIntegrity,
  defaultNameFields,
  formMetaDescription,
  warnFormSchemaOrgFields,
} from "@/lib/form-schema"
import { CANONICAL_SITE_ORIGIN } from "@/lib/schema-org/canonical-origin"
import { buildInvitationPageJsonLd } from "@/lib/schema-org/build-invitation-page-json-ld"
import { venueConfig } from "../../content/venue"
import { sitePageBackdropCss } from "@/lib/site-page-backdrop-css"
import { MARKETING_ENGAGE_MS } from "astro:env/client"

import {
  invitationFormTracking,
  marketingPageTracking,
} from "@/lib/marketing-page-tracking"

export async function getStaticPaths() {
  const forms = await getCollection("forms")
  assertFormsCollectionIntegrity(forms)

  const paths: {
    params: { formPath: string }
    props: {
      kind: "form" | "thankYou"
      entry: (typeof forms)[number]
    }
  }[] = []

  warnFormSchemaOrgFields(forms)

  for (const entry of forms) {
    const formPath = entry.data.path.replace(/^\//, "")
    const thankYouPath = entry.data.thankYouPath.replace(/^\//, "")

    paths.push({
      params: { formPath },
      props: { kind: "form", entry },
    })
    paths.push({
      params: { formPath: thankYouPath },
      props: { kind: "thankYou", entry },
    })
  }

  return paths
}

type Props = {
  kind: "form" | "thankYou"
  entry: Awaited<ReturnType<typeof getCollection<"forms">>>[number]
}

const { kind, entry: entryFromProps } = Astro.props as Props
/** Re-fetch so dev picks up new frontmatter (e.g. `image`) without a full server restart. */
const entry =
  (await getEntry("forms", entryFromProps.id)) ?? entryFromProps
const { data } = entry

const renderedBody =
  kind === "form" ? await render(entry) : null

const thankYouBody =
  data.messages?.thankYouBody ??
  "We received your request and will get back to you soon."

const thankYouParagraphs = thankYouBody
  .split(/\n\n+/)
  .map((paragraph) => paragraph.trim())
  .filter((paragraph) => paragraph.length > 0)

const nameFields = data.nameFields ?? defaultNameFields(data.fields)

let formLcpImage: Awaited<
  ReturnType<typeof buildFormSplitVisualImage>
> | undefined
if (data.image) {
  const source = resolveFormEventImageSource(data.image)
  formLcpImage = await buildFormSplitVisualImage(source)
}

const tracking =
  kind === "form"
    ? invitationFormTracking(data.title)
    : marketingPageTracking.thankYou

const formDescription =
  kind === "form" ? formMetaDescription(data) : undefined

const eventImageUrl =
  kind === "form" && formLcpImage
    ? new URL(formLcpImage.src, CANONICAL_SITE_ORIGIN).href
    : undefined
const formJsonLd =
  kind === "form"
    ? buildInvitationPageJsonLd({
        venue: venueConfig,
        data,
        pageTitle: data.title,
        pageDescription: formDescription,
        imageUrl: eventImageUrl,
      })
    : undefined

const formPageBackdropCss = sitePageBackdropCss("form-page")
---

{kind === "form" ? (
  <Layout
    title={data.title}
    description={formDescription}
    lang={data.lang}
    tracking={tracking}
    formThirdPartyHints
    lcpImage={formLcpImage}
    marketingEngageAfterLoadMs={MARKETING_ENGAGE_MS}
    jsonLd={formJsonLd}
  >
    <main class:list={["form-page", data.image && "form-page--split"]}>
      <div class:list={[data.image ? "form-page__split" : "form-page__stack"]}>
        {data.image ? (
          <>
            <div class="form-page__masthead form-page__split-masthead">
              <SiteBrand align="start" />
              <header class="form-page__header">
                <h1>{data.title}</h1>
              </header>
            </div>
            <figure class="form-page__visual form-page__split-visual">
              {
                formLcpImage ? (
                  <img
                    src={formLcpImage.src}
                    srcset={formLcpImage.srcSet}
                    sizes={formLcpImage.sizes}
                    alt={data.imageAlt ?? data.title}
                    width={formLcpImage.width}
                    height={formLcpImage.height}
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                  />
                ) : null
              }
            </figure>
            {renderedBody ? (
              <div class="form-page__intro form-page__split-intro">
                <renderedBody.Content />
              </div>
            ) : null}
          </>
        ) : (
          <>
            <div class="form-page__masthead">
              <SiteBrand align="start" />
              <header class="form-page__header">
                <h1>{data.title}</h1>
              </header>
            </div>
            {renderedBody ? (
              <div class="form-page__intro">
                <renderedBody.Content />
              </div>
            ) : null}
          </>
        )}
        <div
          class:list={[
            "form-page__panel",
            data.image && "form-page__split-panel",
          ]}
        >
          <div class="form-page__form">
            <ConfigurableForm
              client:visible={{ rootMargin: "200px" }}
              token={data.token}
              fields={data.fields}
              lang={data.lang}
              submitLabel={data.submitLabel}
              thankYouPath={data.thankYouPath}
              eventId={data.eventId}
              nameFields={nameFields}
              messages={data.messages}
              marketingTracking={tracking}
            >
              <FormPageSkeleton
                slot="fallback"
                fields={data.fields}
                lang={data.lang}
              />
            </ConfigurableForm>
          </div>
        </div>
      </div>
      {data.livestackFooter ? <FormLivestackBrand /> : null}
    </main>
    <script
      is:inline
      set:html={`window.addEventListener("load",function(){var t=document.createElement("script");t.src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";t.async=true;t.defer=true;document.body.appendChild(t);var f=document.createElement("script");f.src="https://formgong.com/fg.js";f.async=true;document.body.appendChild(f);},{once:true});`}
    />
  </Layout>
) : (
  <Layout
    title={data.title}
    lang={data.lang}
    tracking={tracking}
    formThirdPartyHints
  >
    <main class="form-page form-page--thank-you">
      <div class="form-page__masthead">
        <SiteBrand align="start" />
        <h1>{data.title}</h1>
      </div>
      <div class="form-page__thank-you-content">
        <ThankYouBody
          client:only="react"
          paragraphs={thankYouParagraphs}
          locale={data.lang}
          marketingTracking={tracking}
        />
      </div>
    </main>
  </Layout>
)}

<style is:global set:html={formPageBackdropCss}></style>

<style>
  .form-page {
    width: min(75rem, calc(100% - 4rem));
    max-width: 100%;
    margin-block: 2rem;
    margin-inline: auto;
    min-height: calc(100dvh - 4rem);
    padding: 2rem 1.5rem 3rem;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
    background-color: color-mix(in srgb, #0a0a0a 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, #f5f5f5 10%, transparent);
    border-radius: 1rem;
  }

  .form-page__split {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 56rem) {
    .form-page--split .form-page__split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      grid-template-rows: auto auto minmax(0, 1fr);
      column-gap: 3rem;
      row-gap: 1.25rem;
      align-items: start;
    }

    .form-page__split-masthead {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .form-page--split .form-page__split-masthead h1 {
      white-space: nowrap;
    }

    .form-page__split-intro {
      grid-column: 1;
      grid-row: 2;
    }

    .form-page__split-visual {
      grid-column: 1;
      grid-row: 3;
      position: sticky;
      top: 2rem;
      max-height: calc(100dvh - 6rem);
      align-self: start;
    }

    .form-page__split-visual img {
      width: 100%;
      height: 100%;
      max-height: calc(100dvh - 6rem);
    }

    .form-page__split-panel {
      grid-column: 2;
      grid-row: 3;
      align-self: start;
      content-visibility: auto;
      contain-intrinsic-size: auto 720px;
    }
  }

  @media (max-width: 55.99rem) {
    .form-page {
      width: calc(100% - 1.5rem);
      margin-block: 0.75rem;
      margin-inline: auto;
      min-height: calc(100dvh - 1.5rem);
      padding: 1.25rem 1rem 2rem;
    }

    .form-page.form-page--split {
      --form-split-masthead-edge: 1.25rem;
      padding-top: var(--form-split-masthead-edge);
    }

    .form-page--split .form-page__split {
      gap: var(--form-split-masthead-edge);
    }

    .form-page--split .form-page__split-masthead {
      flex-direction: row;
      align-items: center;
      gap: 0.875rem 1rem;
      margin-bottom: 0;
    }

    .form-page--split .form-page__split-panel {
      margin-top: 0.75rem;
    }

    .form-page--split .form-page__split-masthead h1 {
      font-size: clamp(1.125rem, 5vw, 1.5rem);
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .form-page__visual img {
      width: 100%;
      height: auto;
    }

    .form-page__split-panel,
    .form-page__form {
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
  }

  .form-page__masthead {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem 1.5rem;
    min-width: 0;
    margin-bottom: 0.25rem;
  }

  .form-page__masthead .form-page__header {
    flex: 1;
    min-width: 0;
  }

  .form-page__masthead h1 {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.25;
  }

  .form-page--split .form-page__masthead h1 {
    margin-bottom: 0;
  }

  .form-page--split .form-page__intro {
    margin-bottom: 0;
  }

  .form-page__visual {
    margin: 0;
    display: flex;
    width: 100%;
    min-height: 0;
  }

  .form-page__visual img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    max-height: min(70dvh, 42rem);
    object-fit: contain;
    object-position: center;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, #f5f5f5 18%, transparent);
  }

  .form-page__panel {
    min-width: 0;
  }

  .form-page__form {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    container-type: inline-size;
    container-name: form-panel;
  }

  .form-page__stack {
    display: block;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
  }

  .form-page:not(.form-page--split) {
    max-width: 52rem;
  }

  .form-page__header h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .form-page__intro {
    margin-bottom: 1.5rem;
    font-size: 1rem;
    line-height: 1.55;
    color: color-mix(in srgb, #f5f5f5 85%, transparent);
  }

  .form-page__intro :global(p:first-child) {
    margin-top: 0;
  }

  .form-page__intro :global(p:last-child) {
    margin-bottom: 0;
  }

  .form-page.form-page--thank-you {
    max-width: min(100%, 36rem);
    min-height: 0;
    padding: 1.5rem 1.5rem 2rem;
  }

  .form-page--thank-you h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.25;
  }

  .form-page--thank-you .form-page__thank-you-content {
    margin-top: 2rem;
  }

  .form-page--thank-you .form-page__thank-you-content :global(.form-page__thank-you-body) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-page--thank-you .form-page__thank-you-content :global(.form-page__thank-you-body p) {
    margin: 0;
    line-height: 1.55;
    color: color-mix(in srgb, #f5f5f5 85%, transparent);
  }
</style>
